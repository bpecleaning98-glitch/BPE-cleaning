---
import Base from '../layouts/Base.astro';
import { serviceGraph } from '../lib/schema';
import { Image } from 'astro:assets';
import Diamond from '../components/Diamond.astro';
import { SITE } from '../data/site';
import { COMMERCIAL } from '../data/work';
import { HOURLY, VAT_NOTE, ESTIMATE_NOTE } from '../data/pricing';
import { TESTIMONIALS } from '../data/testimonials';
import { COUNTIES, AREAS_SENTENCE } from '../data/areas';

// One usable commercial photo exists, so it sits beside the copy rather than in a
// grid. A one-item gallery grid reads as a gap where more photos should be.
const shot = COMMERCIAL[0];

/**
 * Office rates were NOT revised by the client on 5 Aug 2026, so the flyer ranges
 * stand. Both ends of both ranges are read out of pricing.ts and never retyped
 * here, so a future correction to the data changes this page with it.
 */
const rates = [
  {
    name: 'Regular office cleaning',
    from: HOURLY.officeRegular.from,
    to: HOURLY.officeRegular.to,
    text: 'Your standing clean, whether that is every weekday, twice a week or one evening a week. Worked to a checklist agreed with you at the walkthrough.',
  },
  {
    name: 'Deep office cleaning',
    from: HOURLY.officeDeep.from,
    to: HOURLY.officeDeep.to,
    text: 'The heavier once-off. A reset before you move in, a clean after a fit out, or a seasonal deep clean on top of your regular schedule.',
  },
];

// Facts, all from data files or the short list of things we can actually stand
// over. Nothing here is a claim we cannot evidence.
const facts = [
  { label: 'Hours', value: SITE.hours },
  { label: 'Experience', value: '7+ years trading' },
  { label: 'Coverage', value: `${COUNTIES.length} counties` },
  { label: 'Insurance', value: 'Fully insured' },
  { label: 'Products', value: 'Eco-friendly' },
];

const included = [
  {
    title: 'Workstations and desks',
    text: 'Desks and hot desks wiped down, screens and keyboards dusted around, chairs and hard surfaces left clean and dry.',
  },
  {
    title: 'Kitchens and break rooms',
    text: 'Worktops, sink, tap and splashback, appliance exteriors, tables and chairs. The room your team notices first every morning.',
  },
  {
    title: 'Washrooms and sanitary areas',
    text: 'Toilets, basins, mirrors and chrome cleaned and disinfected, tiling wiped and floors washed into the corners.',
  },
  {
    title: 'Floors hoovered and mopped',
    text: 'Hard floors hoovered and mopped, carpet and entrance mats hoovered, edges and skirting boards done, not only the middle of the room.',
  },
  {
    title: 'Touchpoint disinfection',
    text: 'Door handles, light switches, handrails, lift buttons and shared equipment, the surfaces the most hands land on in a day.',
  },
];

// Hoffman Construction and EEM Building Solutions are the commercial references.
// City Stays carries the commercial tag too, but it is a short and long term
// rentals reference and belongs on the Airbnb page, so its airbnb tag filters it
// out here rather than a hardcoded name check.
const references = TESTIMONIALS.filter((t) => t.tags.includes('commercial') && !t.tags.includes('airbnb'));

// The first reference leads as the scrub quote; its words are split here so the
// template only maps spans. The rest sit in the hairline grid below.
const leadRef = references[0];
const leadRefWords = leadRef ? leadRef.quote.split(' ') : [];
const restRefs = references.slice(1);

const faqs = [
  {
    q: 'Can you clean outside our working hours?',
    a: `Yes. We work ${SITE.hours}, so commercial cleans are usually booked before the office opens or after it closes, with weekend slots available inside the same hours. Your team walks into a finished space rather than working around a hoover.`,
  },
  {
    q: 'How is an office clean priced?',
    a: `After a walkthrough. Regular office cleaning runs from €${HOURLY.officeRegular.from} to €${HOURLY.officeRegular.to} per hour and deep office cleaning from €${HOURLY.officeDeep.from} to €${HOURLY.officeDeep.to} per hour. Where your premises sit inside those ranges depends on the floor area, what goes on the checklist and how often we come. ${ESTIMATE_NOTE} ${VAT_NOTE}`,
  },
  {
    q: 'Do you bring products and equipment?',
    a: 'Yes. The team arrives with professional, eco-friendly products and the equipment for the job, so nothing has to be stored or supplied by you. If a surface in your premises needs a specific product, tell us at the walkthrough and we will work to it.',
  },
  {
    q: 'Are you insured?',
    a: 'Yes. BPE Cleaning Services is fully insured, so your premises and our work are covered while the team is on site.',
  },
  {
    q: 'Do you cover offices outside Dublin?',
    a: `${AREAS_SENTENCE} Send us the address of the premises and we will confirm before the walkthrough is arranged.`,
  },
];

/**
 * Service, FAQPage and BreadcrumbList for this page. `faqs` is handed over as it
 * stands, so the questions and answers in the markup are literally the ones
 * rendered below. The price in the offer is read from data/pricing.ts by
 * lib/schema.ts, never typed here.
 */
const jsonLd = serviceGraph('/office-cleaning-dublin/', faqs, Astro.site);
---
<Base
  title={`Office Cleaning Dublin from €${HOURLY.officeRegular.from}/h | BPE Cleaning`}
  description={`Reliable office and commercial cleaning in Dublin from €${HOURLY.officeRegular.from} per hour, scheduled around your business. Fully insured team.`}
  jsonLd={jsonLd}
>
  <section class="bg-night pt-40 pb-20 text-cream md:pt-48 md:pb-24">
    <div class="container-wide">
      <p class="kicker !text-gold" data-reveal>Commercial</p>
      <h1 class="display-caps mt-6 text-[clamp(2.6rem,7vw,5.5rem)]" data-reveal>
        <span class="line-mask"><span>Office Cleaning</span></span>
        <span class="line-mask"><span style="--d: 0.1s"><span class="accent-word text-[0.62em] text-gold-soft">in</span> Dublin</span></span>
      </h1>
      <p class="mt-8 max-w-xl text-base leading-relaxed text-cream/70" data-reveal style="--d: 0.2s">
        Reliable cleaning for offices and commercial spaces, scheduled around your working hours.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--d: 0.3s">
        <a href="/quote/" class="btn-gold">Get my price</a>
        <a href={SITE.phoneHref} class="btn-outline text-cream">Call {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  {/* Intro: the walkthrough argument beside a slim facts index, split by a
      vertical hairline, the values set in serif so the column reads as an
      editorial sidebar rather than a spec table. */}
  <section class="section-pad bg-porcelain">
    <div class="container-wide grid gap-14 lg:grid-cols-[1.35fr_1fr] lg:gap-0">
      <div class="lg:pr-20">
        <p class="kicker" data-reveal>Commercial Cleaning</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Offices cleaned</span></span>
          <span class="line-mask"><span style="--d: 0.1s">around your <span class="accent-word text-gold-deep">hours</span></span></span>
        </h2>
        <p class="mt-8 max-w-xl text-base leading-relaxed text-ink/70 md:text-lg" data-reveal style="--d: 0.2s">
          Commercial work is quoted after a walkthrough. We come out, look at the premises, agree
          what needs doing and how often, and only then put a price on it. Floor area, layout and
          frequency move the figure far too much for an online form to guess, and a number pulled
          out of the air is no use to either of us.
        </p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.28s">
          The work can happen when your team is not there. We are available seven days a week,
          8:00 to 20:00, so cleans are booked early in the morning, in the evening after close, or
          at the weekend. Offices, showrooms and small commercial units are all handled the same
          way, on a checklist agreed with you and kept to on every visit.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--d: 0.36s">
          <a href="/quote/" class="btn-primary">Book a walkthrough</a>
          <a href={SITE.phoneHref} class="link-caps text-ink">Call {SITE.phoneDisplay}</a>
        </div>
      </div>

      <div class="self-center lg:border-l lg:border-ink/12 lg:pl-14">
        <p class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-stone" data-reveal>
          At a glance
        </p>
        <div class="mt-4 border-b border-ink/15">
          {facts.map((fact, i) => (
            <div class="flex items-baseline justify-between gap-6 border-t border-ink/15 py-5" data-reveal style={`--d: ${0.08 * i}s`}>
              <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone">{fact.label}</span>
              <span class="display text-lg text-ink">{fact.value}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* The checklist as a numbered editorial index: sticky headline column on
      the left, 01..05 hairline rows on the right, same language as WhyBpe. */}
  <section class="section-pad bg-ivory">
    <div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker" data-reveal>What Is Included</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>The checklist your</span></span>
          <span class="line-mask"><span style="--d: 0.1s">office is <span class="accent-word text-gold-deep">judged</span> on</span></span>
        </h2>
        <p class="mt-8 max-w-sm text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.2s">
          Five areas cover almost every commercial premises we clean. Yours is written up at the
          walkthrough so nothing is left to memory.
        </p>
      </div>

      <div>
        <div class="border-t border-ink/15">
          {included.map((item, i) => (
            <div
              class="grid grid-cols-[2.6rem_1fr] items-baseline gap-x-6 border-b border-ink/15 py-7 md:grid-cols-[3.2rem_1fr_1.2fr] md:gap-x-10"
              data-reveal
              style={`--d: ${0.06 * i}s`}
            >
              <span class="font-sans text-[0.66rem] font-semibold tracking-[0.2em] text-stone">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display text-xl text-ink md:text-2xl">{item.title}</h3>
              <p class="col-start-2 mt-2 text-sm leading-relaxed text-ink/60 md:col-start-3 md:mt-0">{item.text}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink/60" data-reveal>
          Anything specific to your premises goes on the same list at the walkthrough, from meeting
          rooms and reception to bins and interior glass, and every visit is measured against it.
        </p>
      </div>
    </div>
  </section>

  {/* Rates: the night band moment. Two hourly ranges split by a single
      hairline, the ghosted diamond hanging behind the numerals. */}
  <section class="relative overflow-hidden bg-night py-20 text-cream md:py-32">
    <Diamond class="pointer-events-none absolute -right-40 -top-44 h-[38rem] w-[38rem] opacity-[0.05]" aria-hidden="true" />

    <div class="container-wide relative">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker !text-gold" data-reveal>Rates</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)]" data-reveal>
            <span class="line-mask"><span>Published rates,</span></span>
            <span class="line-mask"><span style="--d: 0.1s">quoted after a <span class="accent-word text-gold-soft">walkthrough</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-cream/60" data-reveal style="--d: 0.2s">
          These are the hourly rates commercial work is built from. The figure on your quote is set
          once we have seen the space and agreed how often we come.
        </p>
      </div>

      <p class="mt-14 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-cream/50" data-reveal>
        Offices &amp; commercial premises &middot; charged by the hour
      </p>
      <div class="mt-4 grid border-t border-cream/15 md:grid-cols-2">
        {rates.map((rate, i) => (
          <div
            class:list={[
              'border-b border-cream/15 px-1 py-8 sm:px-7 md:border-b-0 md:py-12',
              i > 0 && 'md:border-l md:border-cream/15',
              i === 0 && 'sm:pl-0',
            ]}
            data-reveal
            style={`--d: ${0.08 * i}s`}
          >
            <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-gold">{rate.name}</p>
            <p class="display mt-5 text-[3.4rem] leading-none text-cream md:text-[4rem]">
              <span class="text-gold">€</span>{rate.from}
              <span class="ml-3 align-baseline font-sans text-[0.9rem] font-semibold uppercase tracking-[0.18em] text-cream/60">
                to €{rate.to} per hour
              </span>
            </p>
            <p class="mt-6 max-w-sm text-sm leading-relaxed text-cream/60">{rate.text}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-col justify-between gap-8 border-t border-cream/15 pt-8 md:flex-row md:items-center" data-reveal>
        <p class="max-w-2xl text-sm leading-relaxed text-cream/60">
          Commercial premises are priced on a walkthrough rather than by property size, because
          floor area, the length of the checklist and how often we visit all change the job.
          {' '}{ESTIMATE_NOTE}
        </p>
        <div class="flex shrink-0 flex-wrap items-center gap-4">
          <a href="/quote/" class="btn-gold">Get my price</a>
          <a href="/prices/" class="link-caps text-cream">Full price list</a>
        </div>
      </div>
      <p class="mt-6 text-xs text-cream/40">{VAT_NOTE}</p>
    </div>
  </section>

  {/* The one commercial photograph, given room: an oversized drift frame
      beside the copy, the caption hanging off a gold dash beneath it. */}
  <section class="bg-porcelain py-24 md:py-40">
    <div class="container-wide grid items-center gap-14 lg:grid-cols-[1.15fr_1fr] lg:gap-24">
      <figure data-reveal>
        <span class="media-zoom frame-hover block overflow-hidden border border-ink/10">
          <span class="block" data-drift>
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 52vw, 92vw"
              format="webp"
              quality={78}
              class="aspect-[4/3] w-full scale-110 object-cover"
            />
          </span>
        </span>
        <figcaption class="mt-4 flex items-center gap-4">
          <span class="font-sans text-xs text-ink/55">{shot.caption}</span>
        </figcaption>
      </figure>

      <div>
        <p class="kicker" data-reveal style="--d: 0.1s">Our Work</p>
        <h2 class="display mt-6 text-[clamp(2rem,4.4vw,3.4rem)] text-ink" data-reveal style="--d: 0.16s">
          <span class="line-mask"><span>Finished before</span></span>
          <span class="line-mask"><span style="--d: 0.24s">anyone <span class="accent-word text-gold-deep">arrives</span></span></span>
        </h2>
        <p class="mt-8 max-w-xl text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.3s">
          The staff kitchen is where a cleaning contract is quietly judged. Stainless steel that
          still carries yesterday's marks, a worktop nobody cleared, a sink with a tidemark. This
          one was photographed on a real BPE job, with nothing staged for the camera.
        </p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.36s">
          The same standard runs through the desks, the washrooms, the floors and the touchpoints,
          and the work happens outside your opening hours so the first person through the door in
          the morning sees a finished space.
        </p>
        <div class="mt-10" data-reveal style="--d: 0.42s">
          <a href="/quote/" class="btn-primary">Request a quote</a>
        </div>
      </div>
    </div>
  </section>

  {/* References: the lead letter reads itself in, word by word, under the
      hanging gold quote mark; the rest sit in the hairline grid below. */}
  {references.length > 0 && (
    <section class="section-pad bg-ivory">
      <div class="container-wide">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="kicker" data-reveal>References</p>
            <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
              <span class="line-mask"><span>Signed by the firms</span></span>
              <span class="line-mask"><span style="--d: 0.1s">that <span class="accent-word text-gold-deep">kept</span> us on</span></span>
            </h2>
          </div>
          <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
            Written references from the construction and building companies we clean for, in their
            own words.
          </p>
        </div>

        <figure class="mt-16 grid gap-6 md:grid-cols-[auto_1fr] md:gap-10">
          <span class="display block select-none text-[6rem] leading-[0.6] text-gold md:text-[9rem]" aria-hidden="true">&ldquo;</span>
          <div class="max-w-3xl">
            <blockquote data-quote-scrub>
              <p class="display text-[clamp(1.4rem,2.7vw,2.2rem)] leading-[1.32] text-ink">
                {leadRefWords.map((word) => (
                  <span class="q-word">{word}{' '}</span>
                ))}
              </p>
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-4">
              <span>
                <span class="block font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-ink/70">{leadRef.author}</span>
                <span class="mt-1.5 block font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-stone">{leadRef.area}</span>
              </span>
            </figcaption>
          </div>
        </figure>

        {restRefs.length > 0 && (
          <div class="mt-20 grid gap-12 border-t border-ink/15 pt-12 md:grid-cols-2 md:gap-16">
            {restRefs.map((t, i) => (
              <figure data-reveal style={`--d: ${0.08 * i}s`}>
                <blockquote class="mt-5">
                  <p class="font-display text-lg leading-relaxed text-ink/85 md:text-xl">&ldquo;{t.quote}&rdquo;</p>
                </blockquote>
                <figcaption class="mt-7">
                  <span class="block font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-ink/70">{t.author}</span>
                  <span class="mt-1.5 block font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-stone">{t.area}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section-pad bg-porcelain">
    <div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker" data-reveal>Questions</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Before you</span></span>
          <span class="line-mask"><span style="--d: 0.1s">change <span class="accent-word text-gold-deep">cleaners</span></span></span>
        </h2>
        <p class="mt-8 max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Anything not answered here, ask on the phone. {SITE.hours}.
        </p>
      </div>

      <div class="border-t border-ink/15">
        {faqs.map((item, i) => (
          <details class="group border-b border-ink/15" data-reveal style={`--d: ${0.08 * i}s`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-lg text-ink md:text-xl">{item.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-gold-deep transition-transform duration-300 group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="max-w-2xl pb-6 text-sm leading-relaxed text-ink/65 md:text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* Closing: a night band with the ghosted mark low in the corner, mirroring
      the rates band so the page ends on the same dark register it opened on. */}
  <section class="relative overflow-hidden bg-night py-24 text-cream md:py-36">
    <Diamond class="pointer-events-none absolute -bottom-48 -left-44 h-[38rem] w-[38rem] opacity-[0.05]" aria-hidden="true" />

    <div class="container-wide relative">
      <div class="flex flex-col justify-between gap-10 md:flex-row md:items-end">
        <div>
          <p class="kicker !text-gold" data-reveal>Book It In</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)]" data-reveal>
            <span class="line-mask"><span>Start with a</span></span>
            <span class="line-mask"><span style="--d: 0.1s">quick <span class="accent-word text-gold-soft">walkthrough</span></span></span>
          </h2>
          <p class="mt-8 max-w-xl text-base leading-relaxed text-cream/65" data-reveal style="--d: 0.2s">
            Send us the address and roughly how often you need the premises cleaned. We arrange a
            walkthrough, agree the checklist and confirm your price before anything is booked.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal style="--d: 0.28s">
          <a href="/quote/" class="btn-gold">Get my price</a>
          <a href={SITE.whatsappHref} class="link-caps text-gold-soft" rel="noopener">Or message us on WhatsApp</a>
        </div>
      </div>

      <div class="mt-14 flex flex-wrap items-center gap-x-10 gap-y-5 border-t border-cream/15 pt-8" data-reveal>
        <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-cream/50">Related services</span>
        <a href="/after-builders-cleaning-dublin/" class="link-caps text-cream">After builders cleaning</a>
        <a href="/end-of-tenancy-cleaning-dublin/" class="link-caps text-cream">End of tenancy cleaning</a>
        <a href="/deep-cleaning-dublin/" class="link-caps text-cream">Deep cleaning</a>
      </div>
    </div>
  </section>
</Base>
