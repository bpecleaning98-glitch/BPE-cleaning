---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Diamond from '../components/Diamond.astro';
import { SITE } from '../data/site';
import { COUNTIES } from '../data/areas';
import { ESTIMATE_NOTE } from '../data/pricing';
import { PATHS, breadcrumbs, graph, localBusiness } from '../lib/schema';

/**
 * Rebuilt 21 Aug to the reference's contact anatomy, after Artiom called the
 * old one unreadable on a phone. It was: hero with two buttons, form beside a
 * sticky photo, four oversized channel rows with two more buttons, a
 * three-step explainer with two more, eight county cards, a map, and two
 * final buttons. Six sections and the same call-to-action five times, which
 * on a phone is a very long way of saying "ring us".
 *
 * Now three bands and one job each: the headline hands you straight to the
 * form, a centred panel lists every way to reach a human, and the last band
 * says where we go and shows the map. The closing call to action is the
 * footer's, which every page already has.
 *
 * NO data-reveal and no line-mask anywhere on this page, deliberately. Artiom
 * asked for the text to be simply present when you arrive: this is the page
 * someone opens because they want to talk to a person, and making them watch
 * copy animate in first is the wrong moment for choreography.
 */
const channels = [
  { label: 'Phone', value: SITE.phoneDisplay, href: SITE.phoneHref },
  { label: 'WhatsApp', value: 'Message us', href: SITE.whatsappHref },
  { label: 'Email', value: SITE.email, href: `mailto:${SITE.email}` },
  { label: 'Hours', value: SITE.hours, href: null },
];

const dublin = COUNTIES.find((c) => c.primary);
const rest = COUNTIES.filter((c) => !c.primary);

// Keyless Google Maps embed, centred on the primary service area.
const mapSrc = 'https://www.google.com/maps?q=Dublin,+Ireland&z=10&output=embed';

// The second and last page to carry the full business node. This is the page a
// search engine follows for a phone number and an opening time, so the markup
// and the visible contact panel say the same thing.
const jsonLd = graph(
  localBusiness(Astro.site),
  breadcrumbs([{ name: 'Contact', path: PATHS.contact }], Astro.site)
);
---
<Base
  title={`Contact BPE Cleaning Dublin | Free Quote | ${SITE.phoneDisplay}`}
  description={`Contact BPE Cleaning Services in Dublin by phone, WhatsApp or the quote form. Open ${SITE.hours}. Your quote is free, with no obligation.`}
  jsonLd={jsonLd}
>
  {/* Headline straight into the form, no kicker and no buttons above it.
      pt-36 clears the fixed header without the old hero's dead band. */}
  <section class="bg-porcelain pb-20 pt-36 md:pb-28 md:pt-44">
    <div class="container-wide">
      <h1 class="display-caps max-w-3xl text-[clamp(2.3rem,6.4vw,4.6rem)] leading-[1.06] text-ink">
        Every clean begins <span class="accent-word text-[0.78em] text-gold-deep">with a</span> conversation
      </h1>
      <p class="mt-8 max-w-xl text-base leading-relaxed text-ink/65">
        Tell us the property, the service and roughly when. {ESTIMATE_NOTE}
      </p>

      <div class="mt-14 max-w-3xl md:mt-20">
        <QuoteForm />
      </div>
    </div>
  </section>

  {/* Every route to a human, centred, no buttons: the values ARE the links. */}
  <section class="relative overflow-hidden bg-night py-20 text-cream md:py-28">
    <Diamond class="pointer-events-none absolute -right-40 -top-44 h-[38rem] w-[38rem] opacity-[0.05]" aria-hidden="true" />

    <div class="container-wide relative text-center">
      <h2 class="display text-[clamp(2.1rem,5.4vw,3.6rem)] leading-[1.1] text-cream">
        General <span class="accent-word text-gold-soft">enquiries</span>
      </h2>

      <div class="mx-auto mt-14 flex max-w-md flex-col gap-10">
        {channels.map((channel) => (
          <div>
            <p class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-cream/45">
              {channel.label}
            </p>
            {channel.href ? (
              <a
                href={channel.href}
                rel="noopener"
                class="mt-3 block break-words font-sans text-lg text-cream transition-colors duration-300 hover:text-gold-soft md:text-xl"
              >
                {channel.value}
              </a>
            ) : (
              <p class="mt-3 font-sans text-lg text-cream/85 md:text-xl">{channel.value}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Where we go, then the map. Their location block, our version of it: we
      are a mobile team, so the "address" is the ground we cover. */}
  <section class="bg-porcelain py-20 md:py-28">
    <div class="container-wide">
      <h2 class="display-caps max-w-2xl text-[clamp(2.1rem,5.4vw,3.6rem)] leading-[1.08] text-ink">
        Where we <span class="accent-word text-[0.8em] text-gold-deep">come to</span> you
      </h2>

      <div class="mt-10 font-sans text-base leading-[1.9] text-ink/80">
        <p class="text-ink">{dublin?.name}, city and county</p>
        <p>{rest.map((c) => c.name).join(', ')}</p>
      </div>

      <p class="mt-8 font-sans text-base leading-relaxed text-ink/80">
        We come to your home, office or rental. Send the address or the Eircode and we will
        confirm we reach you.
      </p>

      {/* The live Google map, loaded with the page on Artiom's decision after
          the click-to-load gate was offered twice: he wants the map simply
          there, like every other business site. The privacy page names this
          as the site's one always-on third party, so the promise and the
          page still agree. loading="lazy" means Google is only contacted
          when the visitor actually scrolls down to it, and no-referrer keeps
          the page address out of the request. */}
      <div class="mt-14 border border-ink/15">
        <iframe
          src={mapSrc}
          title="Map of Dublin, Ireland, the main service area of BPE Cleaning Services"
          class="block aspect-[4/3] w-full md:aspect-[21/9]"
          style="border: 0"
          loading="lazy"
          referrerpolicy="no-referrer"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

</Base>
