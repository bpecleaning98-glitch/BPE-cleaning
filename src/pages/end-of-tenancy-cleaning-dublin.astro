---
import Base from '../layouts/Base.astro';
import { serviceGraph } from '../lib/schema';
import Gallery from '../components/Gallery.astro';
import Diamond from '../components/Diamond.astro';
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import { END_OF_TENANCY_ROOMS, END_OF_TENANCY_PROOF } from '../data/work';
import { END_OF_TENANCY, SIZE_LABELS, EXTRAS, HOURLY, VAT_NOTE, ESTIMATE_NOTE } from '../data/pricing';
import { COUNTIES, AREAS_SENTENCE } from '../data/areas';
import { TESTIMONIALS } from '../data/testimonials';

/**
 * Highest commercial intent page on the site. The whole argument is deposit
 * recovery, so every section is built to answer one question: will this clean
 * survive the agent's inspection.
 *
 * Studio is deliberately absent from the table. pricing.ts marks the studio rate
 * as unconfirmed by the client, so publishing it here would invent a price.
 */
const tiers = (['1bed', '2bed', '3bed', '4bed'] as const).map((size) => ({
  size: SIZE_LABELS[size],
  price: END_OF_TENANCY[size],
}));

/**
 * Oven and fridge interiors are ADD-ONS on the client's price list, not part of
 * the fixed price. The proof gallery on this page is mostly appliance interiors,
 * so both are named with their published price wherever those photos appear.
 * Claiming them as included would be the one lie that costs a customer money.
 */
const oven = EXTRAS.find((e) => e.key === 'oven')!;
const fridge = EXTRAS.find((e) => e.key === 'fridge')!;

const rooms = [
  {
    title: 'Kitchen',
    items: [
      'Worktops, splashback and sink descaled and dried',
      'Hob and extractor degreased',
      'Cupboards and drawers cleared, wiped inside and out',
      'Appliance exteriors, including the sides you only see once they are pulled out',
      'Floor washed up to the skirting',
    ],
  },
  {
    title: 'Bathrooms',
    items: [
      'Shower enclosure, glass and tray descaled',
      'Grout and tiling scrubbed',
      'Taps, shower head and chrome polished',
      'Toilet, cistern and the floor behind the pan',
      'Mirror, extractor vent and bin',
    ],
  },
  {
    title: 'Bedrooms and living',
    items: [
      'Wardrobes and drawers cleared and wiped inside',
      'Mattress and bed base wiped down',
      'Skirting boards, door frames and handles',
      'Light switches, sockets and radiators',
      'Carpets hoovered, hard floors mopped',
    ],
  },
  {
    title: 'Throughout',
    items: [
      'Hallways, stairs and landings',
      'Cobwebs off ceilings, corners and light fittings',
      'Window sills and frames wiped',
      'Doors and frames washed on both sides',
      'Bins emptied and the property left aired',
    ],
  },
];

const proofPoints = [
  { label: 'Experience', value: 'Over 7 years trading, cleaning homes and rentals' },
  { label: 'Coverage', value: `${COUNTIES.length} counties, Dublin first` },
  { label: 'Availability', value: SITE.hours },
  { label: 'Peace of mind', value: 'Fully insured, eco-friendly products' },
];

const faqs = [
  {
    q: 'Does the property need to be empty?',
    a: 'Ideally yes. Furniture out, wardrobes and cupboards cleared, fridge emptied and switched off. We can then clean inside and behind everything, which is exactly where an inspection goes. If it is a furnished let, or a few things are still in the property on the day, tell us when you book and we will plan the visit around it.',
  },
  {
    q: 'Are oven and fridge cleaning included?',
    a: `They are add-ons, oven cleaning at ${oven.label} and fridge cleaning at ${fridge.label}, and on a move out clean they are the two we would always suggest. The inside of the oven is the first door most agents open. Anything you add is priced before the job, never added to the bill afterwards.`,
  },
  {
    q: 'How is the price worked out?',
    a: `By the size of the property rather than by the hour, so a stubborn oven does not turn into a bigger bill. End of tenancy is priced exactly as our deep clean, from €${END_OF_TENANCY['1bed']} for a 1 bedroom to €${END_OF_TENANCY['4bed']} for a 4 bedroom, before any add-ons. ${VAT_NOTE} ${ESTIMATE_NOTE}`,
  },
  {
    q: 'How much notice do you need?',
    a: `Send us the handover date as soon as the agent gives it to you and we will confirm what we have free. We work ${SITE.hours}, so the clean can usually sit between the movers leaving and the inspection.`,
  },
  {
    q: 'Which areas do you cover?',
    a: `${AREAS_SENTENCE} If you are not sure, send us your Eircode and we will confirm.`,
  },
];

/** Real reference only. Renders nothing if the tagged testimonial is ever removed. */
const reference = TESTIMONIALS.find((t) => t.tags.includes('endOfTenancy'));
/** Words for the scroll-scrub quote treatment; split here, never inline. */
const referenceWords = reference ? reference.quote.split(' ') : [];

/** The one oversized drift moment on the page: the finished living room. */
const roomsLead = END_OF_TENANCY_ROOMS[0];

const related = [
  { href: '/deep-cleaning-dublin/', label: 'Deep cleaning' },
  { href: '/after-builders-cleaning-dublin/', label: 'After builders cleaning' },
  { href: '/house-cleaning-dublin/', label: 'House cleaning' },
];

/**
 * Service, FAQPage and BreadcrumbList for this page. `faqs` is handed over as it
 * stands, so the questions and answers in the markup are literally the ones
 * rendered below. The price in the offer is read from data/pricing.ts by
 * lib/schema.ts, never typed here.
 */
const jsonLd = serviceGraph('/end-of-tenancy-cleaning-dublin/', faqs, Astro.site);
---
<Base
  title={`End of Tenancy Cleaning Dublin from €${END_OF_TENANCY['1bed']} | BPE Cleaning`}
  description={`Landlord-ready end of tenancy cleaning in Dublin. Fixed prices by property size from €${END_OF_TENANCY['1bed']}. Move out with your deposit intact.`}
  jsonLd={jsonLd}
>
  <section class="bg-night pt-40 pb-20 text-cream md:pt-48 md:pb-24">
    <div class="container-wide">
      <p class="kicker !text-gold" data-reveal>Moving Out</p>
      <h1 class="display-caps mt-6 text-[clamp(2.6rem,7vw,5.5rem)]" data-reveal>
        <span class="line-mask"><span>End of Tenancy</span></span>
        <span class="line-mask"><span style="--d: 0.1s">Cleaning <span class="accent-word text-[0.62em] text-gold-soft">in</span> Dublin</span></span>
      </h1>
      <p class="mt-8 max-w-xl text-base leading-relaxed text-cream/70" data-reveal style="--d: 0.2s">
        A landlord-ready clean for apartments and houses, so you move out with your deposit intact.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--d: 0.3s">
        <a href="/quote/" class="btn-gold">Get my price</a>
        <a href={SITE.phoneHref} class="btn-outline text-cream">Call {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  {/* The argument, stated once: the sticky headline holds while the case
      scrolls past it, then the section closes on the page's one oversized
      drift frame, the finished living room, evidence before any price. */}
  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div class="lg:sticky lg:top-32 lg:self-start">
          <p class="kicker" data-reveal>Deposit Back</p>
          <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>An inspection is</span></span>
            <span class="line-mask"><span style="--d: 0.1s">won in the <span class="accent-word text-gold-deep">detail</span></span></span>
          </h2>
        </div>
        <div class="space-y-6 text-base leading-relaxed text-ink/70 md:text-lg">
          <p data-reveal>
            Moving out in Dublin is a queue of deadlines: the van, the meter readings, the handover
            time the agent picked for you. The clean is the only item on that list with money
            attached to it, because the inspection at the end of it decides whether your deposit
            comes back whole.
          </p>
          <p data-reveal style="--d: 0.08s">
            We clean the property to the standard it will be inspected at, then leave it ready for
            you to hand the keys over. One fixed price, set by the size of the property and agreed
            before we start, so the last bill of your tenancy is not the one that surprises you.
          </p>
          <p data-reveal style="--d: 0.16s">
            If you are the landlord rather than the tenant, it is the same clean between tenancies,
            so the property photographs well and lets again quickly.
          </p>
        </div>
      </div>

      <div class="mt-20 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {proofPoints.map((point, i) => (
          <div class="border-t border-ink/15 pt-5" data-reveal style={`--d: ${0.08 * i}s`}>
            <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone">{point.label}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink/70">{point.value}</p>
          </div>
        ))}
      </div>

      {roomsLead && (
        <figure class="mt-20 md:ml-auto md:w-[74%]" data-reveal>
          <div class="media-zoom frame-hover overflow-hidden border border-ink/10">
            <div class="block" data-drift>
              <Image
                src={roomsLead.src}
                alt={roomsLead.alt}
                class="aspect-[16/10] w-full scale-110 object-cover"
                widths={[768, 1080, 1440]}
                sizes="(min-width: 768px) 74vw, 100vw"
                format="webp"
                quality={78}
              />
            </div>
          </div>
          <figcaption class="mt-4 flex items-center gap-4">
            <span class="font-sans text-xs text-ink/55">{roomsLead.caption ?? roomsLead.alt}</span>
          </figcaption>
        </figure>
      )}
    </div>
  </section>

  {/* The checklist as a numbered index: the headline sits sticky on the left
      while the four rooms run past as editorial rows, 01 to 04. */}
  <section class="section-pad bg-ivory">
    <div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker" data-reveal>What Is Included</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Every room taken</span></span>
          <span class="line-mask"><span style="--d: 0.1s">back to <span class="accent-word text-gold-deep">handover</span></span></span>
        </h2>
        <p class="mt-8 max-w-sm text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.2s">
          A move out clean is not a bigger version of a weekly clean. It is done in the order an
          agent walks the property, top to bottom, inside before outside.
        </p>
      </div>

      <div>
        <div class="border-t border-ink/15">
          {rooms.map((room, i) => (
            <div
              class="grid grid-cols-[2.6rem_1fr] items-baseline gap-x-6 border-b border-ink/15 py-8 md:grid-cols-[3.2rem_1fr_1.4fr] md:gap-x-10"
              data-reveal
              style={`--d: ${0.06 * i}s`}
            >
              <span class="font-sans text-[0.66rem] font-semibold tracking-[0.2em] text-stone">{`0${i + 1}`}</span>
              <h3 class="display text-xl text-ink md:text-2xl">{room.title}</h3>
              <ul class="col-start-2 mt-5 space-y-3.5 md:col-start-3 md:mt-0">
                {room.items.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink/65">
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <p class="mt-8 text-sm leading-relaxed text-ink/60" data-reveal>
          Oven and fridge interiors, interior windows and carpet cleaning are priced as add-ons. They
          are listed with their prices below, and they go on your quote before the job rather than on
          the invoice after it.
        </p>
      </div>
    </div>
  </section>

  {/* The price table on the night band, with the fixed prices INVERTED onto a
      porcelain panel that overhangs the band, the same move as the homepage
      pricing. Add-ons keep the dark side of the split. */}
  <section class="section-pad bg-night text-cream">
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker !text-gold" data-reveal>Fixed Prices</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)]" data-reveal>
            <span class="line-mask"><span>One price, set by</span></span>
            <span class="line-mask"><span style="--d: 0.1s">the <span class="accent-word text-gold-soft">property</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-cream/60" data-reveal style="--d: 0.2s">
          End of tenancy is priced exactly as our deep clean. Nothing is counted by the hour on the
          day, so a stubborn oven costs us the time, not you.
        </p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-2 lg:gap-0">
        <div class="relative bg-porcelain p-8 text-ink shadow-[0_0_0_1px] shadow-gold/40 md:p-10 lg:-my-6 lg:py-16" data-reveal>
          <p class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-gold-deep">
            Fixed price per property
          </p>
          <div class="mt-5 border-t border-ink/12">
            {tiers.map((tier) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-ink/12 py-5">
                <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-ink/60">{tier.size}</span>
                <p class="display text-[2.2rem] leading-none text-ink md:text-[2.6rem]">
                  <span class="align-top text-[0.42em] text-gold-deep">€</span>{tier.price}
                </p>
              </div>
            ))}
          </div>
          <a href="/quote/" class="btn-primary mt-10">Get my price</a>
        </div>

        <div class="flex flex-col border border-cream/12 p-8 md:p-10 lg:border-l-0" data-reveal style="--d: 0.12s">
          <p class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-cream/50">
            Add to any move out clean
          </p>
          <ul class="mt-5 border-t border-cream/15">
            {EXTRAS.map((extra) => (
              <li class="flex items-baseline justify-between gap-6 border-b border-cream/15 py-4">
                <span class="text-sm text-cream/75">{extra.name}</span>
                <span class="font-sans text-sm font-medium text-gold-soft">{extra.label}</span>
              </li>
            ))}
          </ul>
          <p class="mt-8 text-sm leading-relaxed text-cream/60">
            Prefer to be charged by the hour? Deep cleaning, which is the same clean under a different
            name, is also available {HOURLY.deep.label}.
          </p>
          <a href="/prices/" class="link-caps mt-auto self-start pt-8 text-gold-soft">Full price list</a>
        </div>
      </div>

      <p class="mt-14 text-xs text-cream/40" data-reveal>{VAT_NOTE} {ESTIMATE_NOTE}</p>
    </div>
  </section>

  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker" data-reveal>Our Work</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>Handed back ready</span></span>
            <span class="line-mask"><span style="--d: 0.1s">for <span class="accent-word text-gold-deep">inspection</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Photographs from real end of tenancy cleans, taken once the work was finished. Nothing
          staged, nothing borrowed.
        </p>
      </div>
      <Gallery items={END_OF_TENANCY_ROOMS} cols={4} class="mt-14" />
    </div>
  </section>

  {/* The strongest argument on this page. Deposits are lost on the inside of the
      oven and the inside of the fridge, so those photos do more work than any
      wide room shot, even though they are the least attractive of the set.
      Dark band treatment: the ghosted diamond behind, the four appliance
      interiors drifting slowly in their frames, and the reference letter
      brightening word by word as it scrolls. */}
  <section class="relative overflow-hidden bg-night py-20 text-cream md:py-32">
    <Diamond class="pointer-events-none absolute -right-40 -top-44 h-[38rem] w-[38rem] opacity-[0.05]" aria-hidden="true" />

    <div class="container-wide relative">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <p class="kicker !text-gold" data-reveal>What Agents Open First</p>
          <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)]" data-reveal>
            <span class="line-mask"><span>Where your deposit</span></span>
            <span class="line-mask"><span style="--d: 0.1s">is <span class="accent-word text-gold-soft">decided</span></span></span>
          </h2>
        </div>
        <div class="space-y-6 text-base leading-relaxed text-cream/65 md:text-lg">
          <p data-reveal>
            An inspection is rarely failed in the middle of the room. It is failed on the enamel
            inside the oven, on the shelf at the back of the fridge, inside a cupboard nobody
            emptied and along a grout line in the shower.
          </p>
          <p data-reveal style="--d: 0.08s">
            These are the least flattering photographs we own and the only ones that answer the
            question you actually have. Oven interiors are an add-on at {oven.label} and fridge
            interiors at {fridge.label}. On a move out clean, that is the cheapest part of your
            deposit you will ever protect.
          </p>
        </div>
      </div>

      <div class="mt-16 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {END_OF_TENANCY_PROOF.map((item, i) => (
          <figure class:list={[i % 2 === 1 && 'lg:mt-12']} data-reveal style={`--d: ${0.08 * i}s`}>
            <div class="media-zoom frame-hover overflow-hidden border border-cream/12">
              <div class="block" data-drift>
                <Image
                  src={item.src}
                  alt={item.alt}
                  class="aspect-[3/4] w-full scale-110 object-cover"
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw"
                  format="webp"
                  quality={74}
                />
              </div>
            </div>
            <figcaption class="mt-4 text-xs leading-relaxed text-cream/50">{item.caption ?? item.alt}</figcaption>
          </figure>
        ))}
      </div>

      {reference && (
        <figure class="mt-20 grid gap-6 border-t border-cream/15 pt-12 md:grid-cols-[auto_1fr] md:gap-10">
          <span class="display block select-none text-[6rem] leading-[0.6] text-gold md:text-[8rem]" aria-hidden="true">&ldquo;</span>
          <div class="max-w-3xl">
            <blockquote data-quote-scrub>
              <p class="display text-[clamp(1.4rem,2.6vw,2.2rem)] leading-[1.35] text-cream">
                {referenceWords.map((word) => (
                  <span class="q-word">{word}{' '}</span>
                ))}
              </p>
            </blockquote>
            <figcaption class="mt-8 flex flex-wrap items-center gap-4">
              <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-cream/70">
                {reference.author} &middot; {reference.area}
              </span>
            </figcaption>
          </div>
        </figure>
      )}
    </div>
  </section>

  <section class="section-pad bg-porcelain">
    <div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker" data-reveal>Questions</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Before you</span></span>
          <span class="line-mask"><span style="--d: 0.1s">hand back the <span class="accent-word text-gold-deep">keys</span></span></span>
        </h2>
      </div>

      <div class="border-t border-ink/15">
        {faqs.map((item, i) => (
          <details class="group border-b border-ink/15" data-reveal style={`--d: ${0.08 * i}s`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-lg text-ink md:text-xl">{item.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-gold-deep transition-transform duration-300 group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="max-w-2xl pb-6 text-sm leading-relaxed text-ink/65 md:text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad bg-ivory">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="kicker" data-reveal>Book Your Clean</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Tell us your</span></span>
          <span class="line-mask"><span style="--d: 0.1s">handover <span class="accent-word text-gold-deep">date</span></span></span>
        </h2>
        <p class="mt-8 text-base leading-relaxed text-ink/70 md:text-lg" data-reveal style="--d: 0.2s">
          Send the address, the number of bedrooms and the date the keys go back. You get a price
          for the whole job, add-ons included, before anything is booked.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-5" data-reveal style="--d: 0.3s">
          <a href="/quote/" class="btn-primary">Get my price</a>
          <a href={SITE.whatsappHref} class="link-caps text-gold-deep" rel="noopener">Or message us on WhatsApp</a>
        </div>
      </div>

      <div class="mt-16 flex flex-wrap items-center gap-x-10 gap-y-5 border-t border-ink/15 pt-8" data-reveal>
        <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone">Also from BPE</span>
        {related.map((item) => (
          <a href={item.href} class="link-caps text-ink/80 transition-colors duration-300 hover:text-gold-deep">{item.label}</a>
        ))}
      </div>
    </div>
  </section>
</Base>
