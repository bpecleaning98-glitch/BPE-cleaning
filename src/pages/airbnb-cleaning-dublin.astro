---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { serviceGraph } from '../lib/schema';
import Gallery from '../components/Gallery.astro';
import Diamond from '../components/Diamond.astro';
import { SITE } from '../data/site';
import { AIRBNB } from '../data/work';
import { TESTIMONIALS } from '../data/testimonials';
import { FIXED, SIZE_LABELS, VAT_NOTE, ESTIMATE_NOTE } from '../data/pricing';
import { AREAS_SENTENCE, COUNTIES } from '../data/areas';
// The same photograph the homepage opens on, so the two full-bleed moments on
// the site speak with one voice. It is atmosphere, not evidence: this band
// makes no claim about the room, which is why a stock frame belongs here and
// nowhere near the gallery.
import bandPhoto from '../assets/stock/hero-living-room.jpg';

// The City Stays reference is the single strongest proof point on the whole site
// for this service: 80+ properties over 2 years. It belongs here, not buried on
// the homepage with the others.
const cityStays = TESTIMONIALS.find((t) => t.author === 'City Stays');
// Split here in the frontmatter so the template renders one .q-word span per
// word: motion.ts brightens them one by one as the band scrolls through.
const cityStaysWords = cityStays ? cityStays.quote.split(' ') : [];

// The daylight bedroom opens the intro as an oversized drift frame: a real
// BPE job, from the AIRBNB group the gallery below shows small. Large as
// atmosphere, small as evidence.
const introPhoto = AIRBNB[0];

// Sizes shown in both tables. Studio is deliberately omitted: data/pricing marks
// the studio rate as mirrored from 1 bedroom and NOT confirmed by the client, so
// it is quoted on request rather than published.
const sizes = ['1bed', '2bed', '3bed', '4bed'] as const;

const turnoverTiers = sizes.map((size) => ({
  rooms: SIZE_LABELS[size],
  price: FIXED.airbnbTurnover[size],
}));

const deepTiers = sizes.map((size) => ({
  rooms: SIZE_LABELS[size],
  price: FIXED.airbnbDeep[size],
}));

// Lowest published turnover price, for the title and meta description. Never
// type a figure here by hand.
const turnoverFrom = Math.min(...sizes.map((size) => FIXED.airbnbTurnover[size]));

// Every line here is the service the client described. Nothing added.
const included = [
  {
    title: 'Full property clean',
    text: 'Kitchen, bathrooms, bedrooms and living areas reset. Floors hoovered and mopped, surfaces, skirting boards and touch points wiped down.',
  },
  {
    title: 'Bed making and linen change',
    text: 'Beds stripped and made up fresh using the linen you keep at the property, corners squared and cushions set.',
  },
  {
    title: 'Towel replacement',
    text: 'Used towels collected, fresh sets laid out in the bathrooms and bedrooms exactly as your listing photos show them.',
  },
  {
    title: 'Restocking essentials',
    text: 'If you leave stock in the property we top it up: tea, coffee, soap, paper, whatever is on your list for that address.',
  },
  {
    title: 'Guest-ready presentation',
    text: 'Bins emptied, mirrors and glass finished, the details a guest photographs in their first minute in the door.',
  },
  {
    title: 'Inspection report on request',
    text: 'A short written note after the turnover: damage, breakages, anything missing and anything running low, so nothing reaches you through a review.',
  },
];

const proof = [
  { figure: '7+', label: 'Years trading in Dublin' },
  { figure: '80+', label: 'Properties for one short let operator' },
  { figure: '7 days', label: 'A week, 8:00 to 20:00' },
  { figure: `${COUNTIES.length}`, label: 'Counties covered' },
];

const faqs = [
  {
    q: 'Can you work around our check out and check in times?',
    a: 'That is how short lets are cleaned, so yes. Send us the checkout and check in times for the property and we confirm what we can cover before you book anything. We clean seven days a week, 8:00 to 20:00, weekends included, because that is when most turnovers actually happen.',
  },
  {
    q: 'Do you supply the linen, towels and consumables?',
    a: 'We work with the stock you keep at the property. Beds are made up and towels replaced from your own sets, and essentials are restocked from whatever you leave on site. If a property is running short we tell you rather than leaving you to find out from a guest.',
  },
  {
    q: 'Do we need to be there to give access?',
    a: 'No. Access by key safe, lockbox or entry code works fine for us. Whatever the arrangement, it is agreed with you in advance and treated with care, and we are fully insured while we are in the property.',
  },
  {
    q: 'What is the difference between a turnover and an Airbnb deep clean?',
    a: 'A turnover is the clean between guests: reset, linen, towels, restock, presentation. A deep clean goes further into the parts guests do not see every stay, inside the oven and fridge, limescale on glass and tiling, grout, behind and under furniture. A deep clean is worth booking between seasons, after a long stay, or before a busy stretch of bookings.',
  },
  {
    q: 'We manage several listings. Can they be priced together?',
    a: 'Yes, please ask. Tell us how many properties you run, where they are and roughly how often they turn over, and we will quote for the group rather than address by address.',
  },
];

const related = [
  { href: '/deep-cleaning-dublin/', label: 'Deep cleaning' },
  { href: '/end-of-tenancy-cleaning-dublin/', label: 'End of tenancy' },
  { href: '/house-cleaning-dublin/', label: 'House cleaning' },
];

/**
 * Service, FAQPage and BreadcrumbList for this page. `faqs` is handed over as it
 * stands, so the questions and answers in the markup are literally the ones
 * rendered below. The price in the offer is read from data/pricing.ts by
 * lib/schema.ts, never typed here.
 */
const jsonLd = serviceGraph('/airbnb-cleaning-dublin/', faqs, Astro.site);
---
<Base
  title={`Airbnb Cleaning Dublin | Turnovers from €${turnoverFrom} | BPE`}
  description={`Airbnb turnover cleaning in Dublin from €${turnoverFrom} with linen change, restocking and guest-ready presentation. Fixed prices per property size.`}
  jsonLd={jsonLd}
>
  <section class="bg-night pt-40 pb-20 text-cream md:pt-48 md:pb-24">
    <div class="container-wide">
      <p class="kicker !text-gold" data-reveal>Short Lets</p>
      <h1 class="display-caps mt-6 text-[clamp(2.6rem,7vw,5.5rem)]" data-reveal>
        <span class="line-mask"><span>Airbnb Cleaning</span></span>
        <span class="line-mask"><span style="--d: 0.1s"><span class="accent-word text-[0.62em] text-gold-soft">and</span> Turnovers in Dublin</span></span>
      </h1>
      <p class="mt-8 max-w-xl text-base leading-relaxed text-cream/70" data-reveal style="--d: 0.2s">
        Fast, guest-ready turnovers with linen change and restocking, at fixed prices per property size.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--d: 0.3s">
        <a href="/quote/" class="btn-gold">Get my price</a>
        <a href={SITE.phoneHref} class="btn-outline text-cream">Call {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  {/* Intro: what this service is, and the proof strip */}
  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
        <div>
          <p class="kicker" data-reveal>Built For Hosts</p>
          <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>The turnover is</span></span>
            <span class="line-mask"><span style="--d: 0.1s">your <span class="accent-word text-gold-deep">reputation</span></span></span>
          </h2>
        </div>

        <div class="max-w-2xl self-end">
          <p class="text-base leading-relaxed text-ink/70 md:text-lg" data-reveal style="--d: 0.16s">
            A guest opens the door, looks at the bed, opens the fridge, checks the shower. The review is
            written in their head before the bags are down. That is the standard a short let has to be
            cleaned to every single time, not just on the visits you happen to inspect.
          </p>
          <p class="mt-6 text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.24s">
            Short lets are a core part of what we do. One Dublin operator alone has trusted BPE with more
            than 80 of their properties over the past two years, short term and long term. Turnovers are
            priced per property size, so your cost per stay is known before we arrive, and we clean seven
            days a week from 8:00 to 20:00 because that is when guests actually check out.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal style="--d: 0.32s">
            <a href="/quote/" class="btn-primary">Get my turnover price</a>
            <a href={SITE.whatsappHref} class="link-caps text-ink" rel="noopener">WhatsApp us</a>
          </div>
        </div>
      </div>

      {/* The service at full size: one daylight bedroom, drifting slowly */}
      <div class="mt-16 md:mt-24 md:w-[74%]" data-reveal>
        <div class="media-zoom frame-hover overflow-hidden border border-ink/10">
          <div data-drift>
            <Image
              src={introPhoto.src}
              alt={introPhoto.alt}
              class="aspect-[16/10] w-full scale-110 object-cover"
              widths={[768, 1080, 1440]}
              sizes="(min-width: 768px) 74vw, 100vw"
              format="webp"
              quality={78}
            />
          </div>
        </div>
        <p class="mt-4 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-stone">
          {introPhoto.caption}
        </p>
      </div>

      <div class="mt-16 grid border-t border-ink/15 sm:grid-cols-2 lg:grid-cols-4">
        {proof.map((item, i) => (
          <div
            class:list={[
              'border-b border-ink/15 py-8 sm:px-7 lg:border-b-0 lg:py-10',
              i > 0 && 'lg:border-l lg:border-ink/15',
              i === 0 && 'sm:pl-0',
            ]}
            data-reveal
            style={`--d: ${0.08 * i}s`}
          >
            <p class="display text-[2.6rem] leading-none text-ink">{item.figure}</p>
            <p class="mt-5 max-w-[15rem] font-sans text-[0.66rem] font-semibold uppercase leading-relaxed tracking-[0.24em] text-stone">
              {item.label}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* The strongest reference we hold, in the host's own words. The words
      brighten one after another as the band scrolls through, the giant quote
      mark hanging in the left margin. */}
  {cityStays && (
    <section class="section-pad bg-night text-cream">
      <div class="container-wide">
        <p class="kicker !text-gold" data-reveal>In Their Words</p>
        <figure class="mt-12 grid gap-6 md:grid-cols-[auto_1fr] md:gap-10">
          <span class="display block select-none text-[6rem] leading-[0.6] text-gold md:text-[9rem]" aria-hidden="true">&ldquo;</span>
          <div class="max-w-4xl">
            <blockquote data-quote-scrub>
              <p class="display text-[clamp(1.45rem,2.7vw,2.3rem)] leading-[1.35] text-cream">
                {cityStaysWords.map((word) => (
                  <span class="q-word">{word}{' '}</span>
                ))}
              </p>
            </blockquote>
            <figcaption class="mt-10 flex items-center gap-4 border-t border-cream/15 pt-6">
              <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-cream/70">
                {cityStays.author} &middot; {cityStays.area}
              </span>
            </figcaption>
          </div>
        </figure>
      </div>
    </section>
  )}

  {/* What every turnover includes: a numbered index beside a sticky headline */}
  <section class="section-pad bg-ivory">
    <div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker" data-reveal>Every Turnover</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Everything the next</span></span>
          <span class="line-mask"><span style="--d: 0.1s">guest <span class="accent-word text-gold-deep">notices</span></span></span>
        </h2>
        <p class="mt-8 max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          One fixed price covers the whole list, and we clean with eco-friendly products.
        </p>
      </div>

      <div>
        <div class="border-t border-ink/15">
          {included.map((item, i) => (
            <div
              class="grid grid-cols-[2.6rem_1fr] items-baseline gap-x-6 border-b border-ink/15 py-7 md:grid-cols-[3.2rem_1fr_1.35fr] md:gap-x-10"
              data-reveal
              style={`--d: ${0.06 * i}s`}
            >
              <span class="font-sans text-[0.66rem] font-semibold tracking-[0.2em] text-stone">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display text-xl text-ink md:text-2xl">{item.title}</h3>
              <p class="col-start-2 mt-2 text-sm leading-relaxed text-ink/60 md:col-start-3 md:mt-0">{item.text}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 text-sm leading-relaxed text-ink/60" data-reveal>
          Extra keys, a strict same day changeover, a property that needs the oven or the fridge taken back to
          new: tell us at the quote stage and it goes into the price rather than appearing on the invoice.
        </p>
      </div>
    </div>
  </section>

  {/* Prices: turnover, then deep. Every figure comes from data/pricing.ts */}
  <section class="relative overflow-hidden section-pad bg-night text-cream">
    {/* Ghosted mark, barely there, gives the band a back layer */}
    <Diamond class="pointer-events-none absolute -right-40 -top-44 h-[38rem] w-[38rem] opacity-[0.05]" />
    <div class="container-wide relative">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker !text-gold" data-reveal>Host Pricing</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)]" data-reveal>
            <span class="line-mask"><span>Fixed per property,</span></span>
            <span class="line-mask"><span style="--d: 0.1s">not per <span class="accent-word text-gold-soft">guess</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-cream/60" data-reveal style="--d: 0.2s">
          Turnovers are charged per property size, not by the hour, so a difficult changeover never costs
          you more than an easy one.
        </p>
      </div>

      <p class="mt-14 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-cream/50" data-reveal>
        Standard turnover &middot; between guests &middot; fixed price per property
      </p>
      <div class="mt-4 grid border-t border-cream/15 sm:grid-cols-2 lg:grid-cols-4">
        {turnoverTiers.map((tier, i) => (
          <div
            class:list={[
              'border-b border-cream/15 px-1 py-8 sm:px-7 lg:border-b-0 lg:py-10',
              i > 0 && 'lg:border-l lg:border-cream/15',
              i === 0 && 'sm:pl-0',
            ]}
            data-reveal
            style={`--d: ${0.08 * i}s`}
          >
            <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-cream/60">{tier.rooms}</p>
            <p class="font-sans font-medium tracking-[-0.01em] mt-5 text-[3.4rem] leading-none text-cream [font-variant-numeric:tabular-nums] md:text-[4rem]">
              <span class="text-gold">&euro;</span>{tier.price}
            </p>
          </div>
        ))}
      </div>

      <p class="mt-16 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-cream/50" data-reveal>
        Airbnb deep clean &middot; between seasons or after a long stay
      </p>
      <div class="mt-4 border-t border-cream/15">
        {deepTiers.map((tier, i) => (
          <div
            class="flex items-baseline justify-between gap-6 border-b border-cream/15 py-5"
            data-reveal
            style={`--d: ${0.06 * i}s`}
          >
            <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-cream/60">{tier.rooms}</span>
            <span class="font-sans font-medium tracking-[-0.01em] text-2xl text-cream [font-variant-numeric:tabular-nums] md:text-[1.75rem]">
              <span class="align-top text-[0.5em] text-gold">&euro;</span>{tier.price}
            </span>
          </div>
        ))}
      </div>

      <div class="mt-12 flex flex-col justify-between gap-8 border-t border-cream/15 pt-8 md:flex-row md:items-center" data-reveal>
        <p class="max-w-2xl text-sm leading-relaxed text-cream/70">
          Hosting more than one listing? Send the addresses and how often each one turns over and we will
          quote for the group. Studios and larger properties are quoted on request.
        </p>
        <a href="/quote/" class="btn-gold shrink-0">Get my price</a>
      </div>
      <p class="mt-6 text-xs text-cream/40">{VAT_NOTE} {ESTIMATE_NOTE}</p>
    </div>
  </section>

  {/* Real work */}
  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker" data-reveal>Our Work</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>Photographed after</span></span>
            <span class="line-mask"><span style="--d: 0.1s">the <span class="accent-word text-gold-deep">turnover</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Dublin short let properties, shot at the end of the clean and before the next guest arrived.
          Our own jobs, our own photos.
        </p>
      </div>
      <Gallery items={AIRBNB} cols={4} class="mt-14" />
    </div>
  </section>

  {/* Full-bleed pause, over the homepage's own opening photograph */}
  <section class="relative flex min-h-[72svh] items-center justify-center overflow-hidden bg-night py-24 text-center text-cream">
    <div class="absolute inset-[-6%]" data-parallax="0.06" aria-hidden="true">
      <Image
        src={bandPhoto}
        alt=""
        class="h-full w-full object-cover"
        widths={[1080, 1600]}
        sizes="100vw"
        format="webp"
        quality={72}
      />
      {/* Deeper than the 45 percent this band used to wear. That figure was
          set against a photograph with its own dark corners; this one is a
          pale wall edge to edge, and at 45 percent the gold kicker all but
          vanished into it. */}
      <div class="absolute inset-0 bg-night/62"></div>
    </div>

    <div class="container-wide relative">
      <p class="kicker !text-gold" data-reveal>Between Stays</p>
      <h2 class="display-caps mx-auto mt-6 max-w-4xl text-[clamp(1.9rem,4.5vw,3.6rem)]" data-reveal>
        <span class="line-mask"><span>Guest ready,</span></span>
        <span class="line-mask"><span style="--d: 0.1s">every <span class="accent-word text-[0.8em] text-gold-soft">single</span> stay</span></span>
      </h2>
      <div class="mt-10" data-reveal style="--d: 0.2s">
        <a href="/quote/" class="btn-gold">Get my price</a>
      </div>
    </div>
  </section>

  {/* Questions hosts actually ask */}
  <section class="section-pad bg-ivory">
    <div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker" data-reveal>Questions</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>What hosts</span></span>
          <span class="line-mask"><span style="--d: 0.1s">always <span class="accent-word text-gold-deep">ask</span></span></span>
        </h2>
        <p class="mt-8 max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Anything not covered here, ring us. You will get a straight answer from someone who has cleaned
          the type of property you are asking about.
        </p>
      </div>

      <div class="border-t border-ink/15">
        {faqs.map((item, i) => (
          <details class="group border-b border-ink/15" data-reveal style={`--d: ${0.08 * i}s`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-lg text-ink md:text-xl">{item.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-gold-deep transition-transform duration-300 group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="max-w-2xl pb-6 text-sm leading-relaxed text-ink/65 md:text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* Close: book it */}
  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="kicker" data-reveal>Book A Turnover</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Tell us the address</span></span>
          <span class="line-mask"><span style="--d: 0.1s">and the <span class="accent-word text-gold-deep">changeover</span></span></span>
        </h2>
        <p class="mt-8 text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.2s">
          Property size, checkout and check in times, how often it turns over. That is all we need to give
          you a price and a slot. {AREAS_SENTENCE}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5" data-reveal style="--d: 0.28s">
          <a href="/quote/" class="btn-primary">Get my price</a>
          <a href={SITE.whatsappHref} class="link-caps text-gold-deep" rel="noopener">Or message us on WhatsApp</a>
        </div>
      </div>
    </div>

    <div class="container-wide mt-20 border-t border-ink/15 pt-8">
      <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone" data-reveal>
        Also for short let owners
      </p>
      <div class="mt-6 flex flex-wrap gap-x-10 gap-y-5">
        {related.map((item, i) => (
          <a href={item.href} class="link-caps text-ink" data-reveal style={`--d: ${0.08 * i}s`}>{item.label}</a>
        ))}
      </div>
    </div>
  </section>
</Base>
