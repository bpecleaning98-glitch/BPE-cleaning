---
import Legal, { type LegalSection } from '../layouts/Legal.astro';
import { PATHS } from '../lib/schema';
import { SITE, legalParticulars } from '../data/site';

/**
 * Written to describe what this site ACTUALLY does, line by line, not a
 * generic template. Every claim here is checkable against the code:
 *   src/scripts/track.ts     what the browser sends (and that it stores nothing)
 *   src/scripts/motion.ts    the one word kept for a single page load
 *   src/pages/api/track.ts   what the server writes down, and how it groups visits
 *   src/lib/session.ts       the 30 minute rule that groups pages into a visit
 *   src/pages/api/lead.ts    what a quote request stores, and the notification
 *   src/lib/email.ts         the notification email, sent through Resend
 *   src/pages/go/[code].ts   what a campaign link records before it forwards
 *   src/lib/request.ts       the daily visitor hash, geolocation, rate limiting
 *   src/lib/db.ts            the two Supabase clients
 *   supabase/schema.sql      purge_old_data(), which enforces the two periods below
 *
 * It also carries what GDPR Article 13 makes mandatory and a plain-English
 * page can still say kindly: who the controller is, the lawful basis for each
 * purpose, the processors and where they are, how long things are kept, the
 * full list of rights and the route to the Data Protection Commission.
 *
 * If any of those files change, this page changes with them. A privacy page
 * that drifts from the code is worse than none, because it is a promise the
 * software is quietly breaking.
 */
const particulars = legalParticulars();

const sections: LegalSection[] = [
  {
    title: 'Nothing stored in your browser, and no trackers belonging to anyone else',
    body: [
      'This site sets no cookies and keeps no identifier of any kind in your browser: no cookie, no local storage, no session marker, no fingerprint. It carries no advertising, no Google Analytics, no Facebook pixel, no fonts fetched from another company and no share buttons that watch you. Nothing here follows you to any other website.',
      'There is one word the site keeps for a single page load. When you tap the logo to go back to the homepage, a note reading "skip the intro" is written for the next page, which reads it, deletes it and skips the opening animation you have already seen. It holds no identifier, cannot be read by anyone else, and exists only to do what you just asked. The <a href="/cookies/">cookies page</a> describes it in full.',
      'There is no consent banner because there is nothing stored to consent to. The two places where something from outside can load, the map on the contact page and a video inside an article, are named further down, and neither happens until you reach them.',
    ],
  },
  {
    title: 'What is counted when you visit',
    body: [
      'The site counts its own visits, on its own server, so the owner can see whether the website is doing its job. For each page opened it records the page address, the website or campaign link you arrived from, whether you are on a phone, a tablet or a computer, which browser you use, your approximate country and city, your browser language, and how long the page was actually on screen.',
      'Pages are grouped into visits on the server, not in your browser: a page opened within 30 minutes of another page from the same daily code, described below, counts as part of the same visit. Nothing is placed on your device to make that grouping work.',
      'A tap on one of the short campaign links, the kind printed on a flyer or posted online, is recorded in the same spirit before it forwards you: the code that was used, the device, the approximate country and city, and the site the tap came from.',
      'Your IP address is never stored. It is used in memory for three things and then discarded: to work out the approximate country and city, to slow down scripts hammering the server, and to produce a one way daily code so repeat pages are not counted as repeat people. Nobody who obtained a copy of this data could turn that code back into an address, and it is thrown away and regenerated from scratch every day.',
      'The law calls the reason for this a legitimate interest, Article 6(1)(f) of the GDPR. In plain terms, the owner is entitled to know whether the money spent on this website comes back, and this is the least invasive way to find out: nothing here identifies you, and nothing leaves this site.',
      'If your browser sends the Global Privacy Control signal, none of the above is recorded at all. Not the page views, not the campaign clicks. The site checks for it both in the browser and again on the server, so the promise does not depend on one script loading.',
    ],
  },
  {
    title: 'When you ask for a price',
    body: [
      'The quote form stores what you type into it: your name, your phone number, the service and property size, your preferred date, your area and any note you add. It asks for nothing else, and only a name or a phone number is needed for it to send. Alongside it the server writes down which link or advert brought your visit, worked out from the pages that visit opened, and the number of that visit, so the request sits next to the pages you looked at. That is how the owner knows which advert is worth paying for. If your browser sends the Global Privacy Control signal, that part is left blank.',
      'Before the form sends, it asks you to tick a box confirming that you have read this page and agree to your details being used to answer your request. The legal basis for handling them is that you asked for a price, and the law allows a business to take the steps you ask for before any contract exists, Article 6(1)(b) of the GDPR. The box is there so that nobody sends their details without knowing where they go. Your request is used for that request and for nothing else.',
      'Two things then happen at once. A notification is emailed to the owner, so the request is seen while you are still waiting for an answer: it carries what you typed and is delivered by Resend, named in the next section, into the owner\'s mailbox. And WhatsApp opens on your device with the same details written out, because that is where bookings are actually arranged. WhatsApp belongs to Meta, so from the moment that chat opens, <a href="https://www.whatsapp.com/legal/privacy-policy-eea" rel="noopener">Meta\'s own privacy policy</a> applies to the message as well as ours.',
    ],
  },
  {
    title: 'Who can see it, and who keeps it for us',
    body: [
      'Only BPE Cleaning Services and the person who maintains this website. The data lives in a database that requires a named account to open, and the list of accounts allowed in is short and fixed. It is never sold, never shared with advertisers, and never used to contact you about anything other than the request you sent.',
      'Three companies hold data on our behalf, under written data processing terms, and do nothing else with it. <a href="https://supabase.com/privacy" rel="noopener">Supabase</a> runs the database, on servers inside the European Union. <a href="https://vercel.com/legal/privacy-policy" rel="noopener">Vercel</a> serves the website from the European Union and runs the small programs that write the visit statistics and your request. <a href="https://resend.com/legal/privacy-policy" rel="noopener">Resend</a> delivers the notification email, and only that email: it is a United States company, so that one message leaves the European Union under the EU-US Data Privacy Framework and the standard contractual clauses in Resend\'s data processing agreement. The email lands in the owner\'s mailbox, which is provided by Google, so Google holds it the way any email provider holds mail.',
      'There are exactly two places where something from outside loads on the site itself, and both are visible when they happen. The map on the contact page comes from Google: when you scroll down to it, Google receives your IP address and can set its own cookies, exactly as it does on any site with a Google map. An article on the blog may carry a video, which is loaded from YouTube in its no cookie mode or from Vimeo. If you never visit the contact page and never open an article with a video, nothing of yours reaches either company.',
    ],
  },
  {
    title: 'How long it is kept',
    body: [
      'Visit statistics and campaign clicks are deleted after 13 months. That is a full year of comparison plus a month, and then they are gone.',
      'A quote request is deleted 24 months after the last time anyone touched it. A request being worked on is never lost, and one that was dealt with two years ago does not sit in a database forever.',
      'Both are enforced by the database itself, on a job that runs every night, not by somebody remembering to do it. The notification email is kept in the owner\'s mailbox for as long as the owner keeps her mail, and is deleted on request along with the rest.',
    ],
  },
  {
    title: 'Your rights over all of this',
    body: [
      'Ask for a copy of what is held about you and it will be sent. Ask for it to be deleted and it will be deleted. Neither needs a reason, and both are answered within a month.',
      'You can also ask for anything wrong to be corrected, ask us to pause using your details while a question is sorted out, object to the counting described above, and ask for your details in a file you can take elsewhere. Any of these can be asked for by phone, by WhatsApp or in writing, and there is no charge.',
      'If you think your information has been handled badly, you can complain to the Data Protection Commission, the Irish supervisory authority, at <a href="https://www.dataprotection.ie" rel="noopener">dataprotection.ie</a>. It is free, and you do not need to speak to us first.',
    ],
  },
  {
    title: 'Who is responsible for this',
    body: [
      `The data described on this page is held by ${SITE.name}, ${SITE.area}, which is the controller of it.${particulars ? ` ${particulars}` : ''} Anything on this page, including any of the requests above, can be sent to ${SITE.email} or rung through on ${SITE.phoneDisplay}, ${SITE.hours}.`,
    ],
  },
];
---
<Legal
  title="Privacy | BPE Cleaning Services"
  description="What this website records, what it does not, who holds it for us, how long it is kept and what you can ask for. Written in plain English, and checked against the code."
  kicker="Privacy"
  headline={{ line1: 'What this site', pre: 'knows', accent: 'about', post: 'you' }}
  intro="Short version: no cookies, nothing stored in your browser, no advertising trackers, no IP addresses kept, and nothing about you sold or handed to an advertiser. The long version, including the three companies that hold data for us and the two places something can load from outside, is below."
  sections={sections}
  path={PATHS.privacy}
  crumb="Privacy"
/>
