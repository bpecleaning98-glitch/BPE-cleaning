---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { PATHS, breadcrumbs, faqPage, graph } from '../lib/schema';
import Gallery from '../components/Gallery.astro';
import Diamond from '../components/Diamond.astro';
import { SITE } from '../data/site';
import {
  HOURLY,
  FIXED,
  END_OF_TENANCY,
  EXTRAS,
  DISCOUNTS,
  SIZE_LABELS,
  VAT_NOTE,
  ESTIMATE_NOTE,
} from '../data/pricing';
import { AREAS_SENTENCE } from '../data/areas';
import { TESTIMONIALS } from '../data/testimonials';
import { DEEP_CLEAN } from '../data/work';
// Photo pause between the tables. Both frames are real BPE jobs; neither
// repeats a photo already shown in this page's DEEP_CLEAN gallery.
import stripKitchen from '../assets/work/eot-after-23.jpg';
import stripLiving from '../assets/work/airbnb-01.jpg';

/**
 * The full price list. Every figure on this page is read from data/pricing.ts,
 * never typed as a literal, so a WhatsApp correction from the client changes one
 * file and the whole page follows.
 *
 * STUDIO IS DELIBERATELY ABSENT. pricing.ts marks the studio rate UNCONFIRMED
 * (it currently mirrors the 1 bedroom figure). Publishing a price the client has
 * not confirmed is how a customer arrives expecting a number we never agreed, so
 * the tables run 1 to 4 bedrooms and smaller properties are quoted by phone.
 */
const sizes = ['1bed', '2bed', '3bed', '4bed'] as const;

const jump = [
  { n: '01', label: 'Hourly rates', href: '#hourly', hint: `from €${HOURLY.regular.from} per hour` },
  { n: '02', label: 'Fixed prices by size', href: '#fixed', hint: `from €${FIXED.deep['1bed']}` },
  { n: '03', label: 'Airbnb turnovers', href: '#airbnb', hint: `from €${FIXED.airbnbTurnover['1bed']}` },
  { n: '04', label: 'Extras and discounts', href: '#extras', hint: 'Oven, fridge, windows, carpet' },
  { n: '05', label: 'Price questions', href: '#questions', hint: 'VAT, minimums, areas' },
];

/** `to` is null wherever the client advertises a single "from" figure. */
const hourly = [
  {
    name: 'House cleaning, regular',
    text: `Dusting, hoovering and mopping, kitchen surfaces, bathrooms cleaned and sanitised, bins emptied. Weekly, bi-weekly or once-off, with a minimum booking of ${HOURLY.regular.minHours} hours.`,
    from: HOURLY.regular.from,
    to: null,
    prefix: 'From',
  },
  {
    name: 'Deep cleaning, hourly',
    text: 'Charged by the hour where a fixed price does not fit, for example one room or part of a property. Whole homes are usually booked at the fixed price below.',
    from: HOURLY.deep.from,
    to: null,
    prefix: 'From',
  },
  {
    name: 'After builders cleaning, hourly',
    text: 'For smaller jobs after a renovation, a single room or a snag list finished off. Larger sites are priced per property below.',
    from: HOURLY.afterBuilders.from,
    to: null,
    prefix: 'From',
  },
  {
    name: 'Office cleaning, regular',
    text: 'Offices and commercial spaces cleaned around your working hours, on the days that suit you.',
    from: HOURLY.officeRegular.from,
    to: HOURLY.officeRegular.to,
    prefix: null,
  },
  {
    name: 'Office cleaning, deep',
    text: 'A once-off deep clean of a workplace, kitchen areas and washrooms included.',
    from: HOURLY.officeDeep.from,
    to: HOURLY.officeDeep.to,
    prefix: null,
  },
];

const deepTiers = sizes.map((size) => ({
  rooms: SIZE_LABELS[size],
  price: FIXED.deep[size],
}));
const buildersTiers = sizes.map((size) => ({ rooms: SIZE_LABELS[size], price: FIXED.afterBuilders[size] }));
const airbnbRows = sizes.map((size) => ({
  rooms: SIZE_LABELS[size],
  turnover: FIXED.airbnbTurnover[size],
  deep: FIXED.airbnbDeep[size],
}));

/** What the fixed price covers. Every line is a job in our own photographs. */
const included = [
  'Inside the oven, enamel and racks degreased',
  'Inside the fridge, shelves and drawers wiped out',
  'Inside kitchen cupboards, cleared and left dry',
  'Limescale off shower glass, grout and chrome',
  'Skirting boards and appliance exteriors',
  'Floors washed right up to the skirting',
];

/**
 * Unit text is derived from the label in pricing.ts instead of retyped, so
 * "per window" and "per m²" can never drift away from the source string.
 */
const extras = EXTRAS.map((extra) => ({
  ...extra,
  unit: extra.label.replace('from ', '').replace(`€${extra.price}`, '').trim(),
}));

const EXTRA_TEXT: Record<string, string> = {
  oven: 'Racks, trays and enamel degreased inside and out.',
  fridge: 'Shelves and drawers emptied, wiped and left dry.',
  windows: 'Cleaned from the inside, priced per window.',
  carpet: 'Priced by the square metre of carpet cleaned.',
};

const discounts = [
  {
    name: 'Weekly',
    figure: `${DISCOUNTS.weekly.pct}%`,
    label: DISCOUNTS.weekly.label,
    text: 'Cleaning booked every week, on the day that suits you.',
  },
  {
    name: 'Bi-weekly',
    figure: `${DISCOUNTS.biweekly.pct}%`,
    label: DISCOUNTS.biweekly.label,
    text: 'Cleaning booked every second week.',
  },
  {
    name: 'Monthly',
    figure: null,
    label: DISCOUNTS.monthly.label,
    text: 'Monthly and longer cycles are arranged as a contract and priced for you.',
  },
];

const faqs = [
  {
    q: 'Do these prices include VAT?',
    a: `No. ${VAT_NOTE} The figure you agree with us before the booking is the figure we work to.`,
  },
  {
    q: 'Is the price on this page my final price?',
    a: `These are our published rates. Fixed price cleans are set by the number of bedrooms, hourly work starts at the rates above. ${ESTIMATE_NOTE}`,
  },
  {
    q: 'Is there a minimum booking?',
    a: `Regular house cleaning has a minimum booking of ${HOURLY.regular.minHours} hours. Fixed price cleans are priced per property, so no hourly minimum applies to them.`,
  },
  {
    q: 'Is end of tenancy dearer than a deep clean?',
    a: `No. End of tenancy cleaning is priced exactly the same as deep cleaning, from €${END_OF_TENANCY['1bed']} for a one bedroom and €${END_OF_TENANCY['4bed']} for four bedrooms.`,
  },
  {
    q: 'What if my property is larger than four bedrooms?',
    a: 'Anything larger than four bedrooms, or a property in unusual condition, is priced individually. Send us the details or ring us and we will give you the figure.',
  },
  {
    q: 'Do I pay extra for products and equipment?',
    a: 'No. Our team arrives with professional, eco-friendly products and all the equipment needed for the job.',
  },
  {
    q: 'How do the recurring discounts work?',
    a: `Weekly cleaning saves ${DISCOUNTS.weekly.pct}% and bi-weekly saves ${DISCOUNTS.biweekly.pct}%, applied to each recurring clean. ${DISCOUNTS.monthly.label} covers monthly and longer cycles.`,
  },
  {
    q: 'Do these prices apply outside Dublin?',
    a: `${AREAS_SENTENCE} Send us your Eircode when you get in touch and your price is confirmed before anything is booked.`,
  },
];

const cityStays = TESTIMONIALS.find((t) => t.author === 'City Stays');
const deepQuote = TESTIMONIALS.find((t) => t.author === 'Ivan Spanjic');
/** Split for the scroll scrub: each word brightens as the quote passes. */
const cityStaysWords = cityStays ? cityStays.quote.split(' ') : [];

/**
 * The price questions further down are the FAQ this page publishes, so `faqs` is
 * marked up exactly as rendered, word for word. No price is repeated here: every
 * figure inside those answers is already interpolated from data/pricing.ts.
 */
const jsonLd = graph(
  faqPage(faqs, PATHS.prices, Astro.site),
  breadcrumbs([{ name: 'Prices', path: PATHS.prices }], Astro.site)
);
---
<Base
  title="Cleaning Prices Dublin | Full Price List | BPE Cleaning"
  description="The full BPE Cleaning price list for Dublin: hourly rates, fixed prices by property size, extras and recurring discounts. No hidden fees."
  jsonLd={jsonLd}
>
  <section class="bg-night pt-40 pb-20 text-cream md:pt-48 md:pb-24">
    <div class="container-wide">
      <p class="kicker !text-gold" data-reveal>Transparent Pricing</p>
      <h1 class="display-caps mt-6 text-[clamp(2.6rem,7vw,5.5rem)]" data-reveal>
        <span class="line-mask"><span>Our cleaning</span></span>
        <span class="line-mask"><span style="--d: 0.1s"><span class="accent-word text-gold-soft">prices</span></span></span>
      </h1>
      <p class="mt-8 max-w-xl text-base leading-relaxed text-cream/70" data-reveal style="--d: 0.2s">
        Hourly rates, fixed prices by property size and extras, all in one place. No hidden fees.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--d: 0.3s">
        <a href="/quote/" class="btn-gold">Get my price</a>
        <a href={SITE.phoneHref} class="btn-outline text-cream">Call {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <!-- Intro: a sticky manifesto column beside the page index, restyled as
       numbered editorial rows in the WhyBpe manner -->
  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      <div class="mt-8 grid gap-14 lg:grid-cols-[1fr_1.35fr] lg:gap-20">
        <div class="lg:sticky lg:top-32 lg:self-start">
          <p class="kicker" data-reveal>The Full List</p>
          <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>Every price we charge,</span></span>
            <span class="line-mask"><span style="--d: 0.1s">in the <span class="accent-word text-gold-deep">open</span></span></span>
          </h2>
          <p class="mt-8 max-w-md text-base leading-relaxed text-ink/70" data-reveal style="--d: 0.2s">
            You should be able to see what a clean costs before you pick up the phone. These are our
            published rates, the same ones we quote from. Read them, work out roughly what your clean
            will cost, then talk to us and we confirm the exact figure.
          </p>
          <div class="mt-8 flex flex-col gap-2.5" data-reveal style="--d: 0.28s">
            <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone">{VAT_NOTE}</span>
            <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone">{ESTIMATE_NOTE}</span>
          </div>
        </div>

        <nav class="border-t border-ink/15" aria-label="Price list sections">
          {jump.map((item, i) => (
            <a
              href={item.href}
              class="group grid grid-cols-[2.6rem_1fr] items-baseline gap-x-6 border-b border-ink/15 py-7 md:grid-cols-[3.2rem_1fr_auto] md:gap-x-10 md:py-8"
              data-reveal
              style={`--d: ${0.06 * i}s`}
            >
              <span class="font-sans text-[0.66rem] font-semibold tracking-[0.2em] text-gold-deep">{item.n}</span>
              <span class="display text-xl text-ink transition-colors duration-300 group-hover:text-gold-deep md:text-2xl">{item.label}</span>
              <span class="col-start-2 mt-2 flex items-center gap-3 md:col-start-3 md:mt-0">
                <span class="font-sans text-xs text-ink/55 [font-variant-numeric:tabular-nums]">{item.hint}</span>
                <svg
                  class="h-3.5 w-3.5 shrink-0 -translate-x-1 text-gold-deep opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M14 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- 01. Hourly rates -->
  <section id="hourly" class="section-pad bg-ivory scroll-mt-24">
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker" data-reveal>01 &middot; Hourly Rates</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>Cleaning charged</span></span>
            <span class="line-mask"><span style="--d: 0.1s">by the <span class="accent-word text-gold-deep">hour</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Hourly work suits regular cleaning and smaller jobs. Anything that covers a whole property is
          usually cheaper at the fixed prices further down.
        </p>
      </div>

      <div class="mt-14 border-t border-ink/15">
        {hourly.map((row, i) => (
          <div
            class="group grid items-baseline gap-x-6 gap-y-4 border-b border-ink/15 py-8 md:grid-cols-[3.2rem_minmax(0,1fr)_auto] md:gap-x-10 md:py-10"
            data-reveal
            style={`--d: ${0.07 * i}s`}
          >
            <span class="hidden font-sans text-[0.66rem] font-semibold tracking-[0.2em] text-stone md:block">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="display text-xl text-ink transition-colors duration-300 group-hover:text-gold-deep md:text-2xl">{row.name}</h3>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/60">{row.text}</p>
            </div>
            <div class="md:text-right">
              {row.prefix && (
                <span class="block font-sans text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-stone">{row.prefix}</span>
              )}
              <p class="font-sans font-medium tracking-[-0.01em] mt-2 text-[2.6rem] leading-none text-ink [font-variant-numeric:tabular-nums] md:text-[3.2rem]">
                <span class="text-gold-deep">€</span>{row.from}
                <span class="font-sans text-[0.3em] font-semibold uppercase tracking-[0.2em] text-ink/50"> per hour</span>
              </p>
              {row.to && (
                <span class="mt-3 block font-sans text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-stone [font-variant-numeric:tabular-nums]">
                  Up to €{row.to} per hour
                </span>
              )}
            </div>
          </div>
        ))}
      </div>

      <p class="mt-8 text-xs text-stone" data-reveal>{VAT_NOTE} {ESTIMATE_NOTE}</p>
    </div>
  </section>

  <!-- 02. Fixed prices per property size: the headline table sits on an
       inverted porcelain panel that overhangs the night band, the after
       builders table beside it in hairlines, the diamond ghosted behind -->
  <section id="fixed" class="relative overflow-hidden bg-night py-20 text-cream scroll-mt-24 md:py-32">
    <Diamond class="pointer-events-none absolute -right-40 -top-44 h-[38rem] w-[38rem] opacity-[0.05]" aria-hidden="true" />

    <div class="container-wide relative">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker !text-gold" data-reveal>02 &middot; Fixed Prices</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)]" data-reveal>
            <span class="line-mask"><span>Fixed prices by</span></span>
            <span class="line-mask"><span style="--d: 0.1s">property <span class="accent-word text-gold-soft">size</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-cream/60" data-reveal style="--d: 0.2s">
          One price for the whole property, agreed before we start. Bedrooms are how we size the job, so
          you can find your own home in the row below.
        </p>
      </div>

      <div class="mt-16 grid gap-6 lg:grid-cols-[1.05fr_1fr] lg:gap-0">
        {/* The headline table, inverted onto porcelain */}
        <div class="relative flex flex-col bg-porcelain p-8 text-ink shadow-[0_0_0_1px] shadow-gold/40 md:p-12 lg:-my-6 lg:py-16" data-reveal>
          <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-gold-deep">
            Deep Cleaning &amp; End of Tenancy
          </p>
          <p class="mt-6 flex items-baseline gap-3">
            <span class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-ink/45">From</span>
            <span class="font-sans font-medium tracking-[-0.01em] text-[3.4rem] leading-none text-ink [font-variant-numeric:tabular-nums] md:text-[4rem]">
              <span class="text-gold">€</span>{FIXED.deep['1bed']}
            </span>
          </p>
          <ul class="mt-8 border-t border-ink/12">
            {deepTiers.map((tier) => (
              <li class="flex items-baseline justify-between border-b border-ink/12 py-4">
                <span class="font-sans text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-ink/60">{tier.rooms}</span>
                <span class="font-sans font-medium tracking-[-0.01em] text-2xl text-ink [font-variant-numeric:tabular-nums]">€{tier.price}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-ink/60">
            End of tenancy cleaning is priced exactly as a deep clean. Moving out and deep cleaning are
            the same work, so we charge the same for both.
          </p>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
            <a href="/deep-cleaning-dublin/" class="link-caps text-gold-deep">Deep cleaning</a>
            <a href="/end-of-tenancy-cleaning-dublin/" class="link-caps text-gold-deep">End of tenancy</a>
          </div>
        </div>

        {/* After builders, in hairlines on the night band */}
        <div class="flex flex-col border border-cream/12 p-8 md:p-12 lg:border-l-0" data-reveal style="--d: 0.12s">
          <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-gold">After Builders</p>
          <p class="mt-6 flex items-baseline gap-3">
            <span class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-cream/50">From</span>
            <span class="font-sans font-medium tracking-[-0.01em] text-[3.4rem] leading-none text-cream [font-variant-numeric:tabular-nums] md:text-[4rem]">
              <span class="text-gold">€</span>{FIXED.afterBuilders['1bed']}
            </span>
          </p>
          <ul class="mt-8 border-t border-cream/12">
            {buildersTiers.map((tier) => (
              <li class="flex items-baseline justify-between border-b border-cream/12 py-4">
                <span class="font-sans text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-cream/65">{tier.rooms}</span>
                <span class="font-sans font-medium tracking-[-0.01em] text-2xl text-cream [font-variant-numeric:tabular-nums]">€{tier.price}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-cream/55">
            Construction dust travels into every track, hinge and socket, which is why an after builders
            clean costs more than a deep clean of the same property. Sites that are still being finished
            are quoted after we see them.
          </p>
          <a href="/after-builders-cleaning-dublin/" class="link-caps mt-8 self-start text-gold-soft">View service</a>
        </div>
      </div>

      <div class="mt-20 grid gap-10 border-t border-cream/15 pt-10 md:grid-cols-[auto_minmax(0,1fr)] md:gap-16">
        <h3 class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-cream/50" data-reveal>
          What a fixed price covers
        </h3>
        <ul class="grid gap-x-10 gap-y-3 sm:grid-cols-2">
          {included.map((item, i) => (
            <li class="flex items-start gap-3 text-sm text-cream/70" data-reveal style={`--d: ${0.05 * i}s`}>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-12 flex flex-col justify-between gap-6 border-t border-cream/15 pt-8 md:flex-row md:items-center" data-reveal>
        <p class="text-xs text-cream/40">{VAT_NOTE} {ESTIMATE_NOTE}</p>
        <a href="/quote/" class="btn-gold shrink-0">Get my price</a>
      </div>
    </div>
  </section>

  <!-- A photographic pause between the tables: two drift frames, real jobs -->
  <section class="section-pad bg-ivory">
    <div class="container-wide">
      <div class="grid gap-6 md:grid-cols-12 md:gap-8">
        <figure class="md:col-span-7" data-reveal>
          <span class="media-zoom frame-hover block overflow-hidden border border-ink/10">
            <span class="block" data-drift>
              <Image
                src={stripKitchen}
                alt="Kitchen cleaned and cleared at handover"
                class="aspect-[4/3] w-full scale-110 object-cover"
                widths={[768, 1080, 1440]}
                sizes="(min-width: 768px) 58vw, 100vw"
                format="webp"
                quality={78}
              />
            </span>
          </span>
          <figcaption class="mt-4 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-stone">
            Kitchen at handover, oven and hob cleaned
          </figcaption>
        </figure>
        <figure class="md:col-span-5 md:mt-24" data-reveal style="--d: 0.12s">
          <span class="media-zoom frame-hover block overflow-hidden border border-ink/10">
            <span class="block" data-drift>
              <Image
                src={stripLiving}
                alt="Living area with window seat, cleaned and reset between guests"
                class="aspect-[4/5] w-full scale-110 object-cover"
                widths={[480, 768, 1080]}
                sizes="(min-width: 768px) 40vw, 100vw"
                format="webp"
                quality={78}
              />
            </span>
          </span>
          <figcaption class="mt-4 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-stone">
            Living area reset between guests
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 03. Airbnb -->
  <section id="airbnb" class="section-pad bg-porcelain scroll-mt-24">
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker" data-reveal>03 &middot; Short Stays</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>Turnovers priced</span></span>
            <span class="line-mask"><span style="--d: 0.1s">per <span class="accent-word text-gold-deep">property</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          A turnover is the between-guest clean with a linen change and restocking. The deep clean column
          is the seasonal reset, priced the same as any other deep clean.
        </p>
      </div>

      <div class="mt-14 border-t border-ink/15">
        <div class="grid grid-cols-[minmax(0,1fr)_4.75rem_4.75rem] items-baseline gap-4 border-b border-ink/15 py-4 md:grid-cols-[minmax(0,1fr)_9rem_9rem] md:gap-6">
          <span class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-stone">Property</span>
          {/* nowrap + tighter phone tracking: at 0.24em "Deep clean" is 84px
              against the 76px mobile column and wraps below the baseline. */}
          <span class="whitespace-nowrap text-right font-sans text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-stone md:tracking-[0.24em]">Turnover</span>
          <span class="whitespace-nowrap text-right font-sans text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-stone md:tracking-[0.24em]">Deep clean</span>
        </div>
        {airbnbRows.map((row, i) => (
          <div
            class="group grid grid-cols-[minmax(0,1fr)_4.75rem_4.75rem] items-baseline gap-4 border-b border-ink/15 py-6 md:grid-cols-[minmax(0,1fr)_9rem_9rem] md:gap-6"
            data-reveal
            style={`--d: ${0.07 * i}s`}
          >
            <span class="font-display text-lg text-ink transition-colors duration-300 group-hover:text-gold-deep md:text-xl">{row.rooms}</span>
            <span class="font-sans font-medium tracking-[-0.01em] block text-right text-[1.5rem] leading-none text-ink [font-variant-numeric:tabular-nums] md:text-[2.6rem]">
              <span class="text-gold-deep">€</span>{row.turnover}
            </span>
            <span class="font-sans font-medium tracking-[-0.01em] block text-right text-[1.5rem] leading-none text-ink/70 [font-variant-numeric:tabular-nums] md:text-[2.6rem]">
              <span class="text-gold-deep">€</span>{row.deep}
            </span>
          </div>
        ))}
      </div>

      <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink/60" data-reveal>
        Hosts with several properties usually run on a standing arrangement rather than booking one clean
        at a time. Tell us how many units you have and how often they turn over, and we price it together.
      </p>
      <p class="mt-4 text-xs text-stone" data-reveal>{VAT_NOTE} {ESTIMATE_NOTE}</p>

      {cityStays && (
        <figure class="mt-20 grid gap-6 border-t border-ink/15 pt-12 md:grid-cols-[auto_1fr] md:gap-10">
          <span class="display block select-none text-[5rem] leading-[0.6] text-gold md:text-[7rem]" aria-hidden="true">&ldquo;</span>
          <div class="max-w-3xl">
            <blockquote data-quote-scrub>
              <p class="display text-[clamp(1.4rem,2.5vw,2.1rem)] leading-[1.35] text-ink">
                {cityStaysWords.map((word) => (
                  <span class="q-word">{word}{' '}</span>
                ))}
              </p>
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-4">
              <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-ink/70">
                {cityStays.author} &middot; {cityStays.area}
              </span>
            </figcaption>
          </div>
        </figure>
      )}
    </div>
  </section>

  <!-- 04. Extras and recurring discounts -->
  <section id="extras" class="section-pad bg-ivory scroll-mt-24">
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker" data-reveal>04 &middot; Extras and Discounts</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>Add what you need,</span></span>
            <span class="line-mask"><span style="--d: 0.1s">save when it <span class="accent-word text-gold-deep">repeats</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Extras can be added to any booking, hourly or fixed price. Tell us when you book so the time is
          allowed for on the day.
        </p>
      </div>

      <div class="mt-14 grid border-t border-ink/15 sm:grid-cols-2 lg:grid-cols-4">
        {extras.map((extra, i) => (
          <div
            class:list={[
              'group border-b border-ink/15 py-8 sm:px-7 lg:py-10',
              i > 0 && 'lg:border-l lg:border-ink/15',
              i === 0 && 'sm:pl-0',
            ]}
            data-reveal
            style={`--d: ${0.08 * i}s`}
          >
            <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone">
              {extra.from ? 'From' : 'Fixed'}
            </p>
            <p class="font-sans font-medium tracking-[-0.01em] mt-4 text-[2.6rem] leading-none text-ink [font-variant-numeric:tabular-nums] md:text-[3rem]">
              <span class="text-gold-deep">€</span>{extra.price}
            </p>
            {extra.unit && (
              <p class="mt-3 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-stone">{extra.unit}</p>
            )}
            <h3 class="mt-5 font-display text-lg text-ink transition-colors duration-300 group-hover:text-gold-deep">{extra.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/60">{EXTRA_TEXT[extra.key]}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-20 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.26em] text-stone" data-reveal>
        Recurring cleaning discounts
      </h3>
      <div class="mt-4 grid border-t border-ink/15 md:grid-cols-3">
        {discounts.map((item, i) => (
          <div
            class:list={[
              'border-b border-ink/15 py-8 md:border-b-0 md:px-7 md:py-10',
              i > 0 && 'md:border-l md:border-ink/15',
              i === 0 && 'md:pl-0',
            ]}
            data-reveal
            style={`--d: ${0.08 * i}s`}
          >
            <p class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-stone">{item.name}</p>
            {item.figure ? (
              <p class="font-sans font-medium tracking-[-0.01em] mt-4 text-[3rem] leading-none text-ink [font-variant-numeric:tabular-nums] md:text-[3.6rem]">{item.figure}</p>
            ) : (
              <p class="display mt-4 text-[1.6rem] leading-tight text-ink md:text-[2rem]">On request</p>
            )}
            <p class="mt-4 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-gold-deep">{item.label}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink/60">{item.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-xs text-stone" data-reveal>
        Discounts apply to the recurring clean. {VAT_NOTE}
      </p>
    </div>
  </section>

  <!-- Proof: the work behind the numbers -->
  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker" data-reveal>Our Own Work</p>
          <h2 class="display mt-6 max-w-2xl text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
            <span class="line-mask"><span>What the price</span></span>
            <span class="line-mask"><span style="--d: 0.1s">actually <span class="accent-word text-gold-deep">buys</span></span></span>
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Photographs from BPE jobs in Dublin, not stock images. The details below are the ones an agent or
          a guest checks first.
        </p>
      </div>

      <Gallery items={DEEP_CLEAN} cols={4} class="mt-14" />

      {deepQuote && (
        <figure class="mt-16 max-w-3xl border-t border-ink/15 pt-8" data-reveal>
          <blockquote>
            <p class="font-display text-lg leading-relaxed text-ink/80 md:text-xl">&ldquo;{deepQuote.quote}&rdquo;</p>
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-4">
            <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-ink/70">
              {deepQuote.author} &middot; {deepQuote.area}
            </span>
          </figcaption>
        </figure>
      )}
    </div>
  </section>

  <!-- 05. Price questions -->
  <section id="questions" class="section-pad bg-ivory scroll-mt-24">
    <div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="kicker" data-reveal>05 &middot; Price Questions</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span>Questions about</span></span>
          <span class="line-mask"><span style="--d: 0.1s">the <span class="accent-word text-gold-deep">price</span></span></span>
        </h2>
        <p class="mt-8 max-w-sm text-sm leading-relaxed text-ink/60" data-reveal style="--d: 0.2s">
          Anything not answered here, ring us on {SITE.phoneDisplay}. We answer {SITE.hours}.
        </p>
      </div>

      <div class="border-t border-ink/15">
        {faqs.map((item, i) => (
          <details class="group border-b border-ink/15" data-reveal style={`--d: ${0.06 * i}s`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-lg text-ink md:text-xl">{item.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-gold-deep transition-transform duration-300 group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="max-w-2xl pb-6 text-sm leading-relaxed text-ink/65 md:text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* No closing call to action. The page ends on the price questions, and
      the footer that follows opens with "Ready when you are" and the same
      two actions. The old section here repeated the buttons a third time
      next to a Phone/WhatsApp/Hours/Areas panel, which Artiom read, fairly,
      as clutter: everything in it already lives in the footer below. */}
</Base>
