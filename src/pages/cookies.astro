---
import Legal, { type LegalSection } from '../layouts/Legal.astro';
import { PATHS } from '../lib/schema';
const sections: LegalSection[] = [
  { title: 'Your choice comes first', body: ['Optional Google Analytics is off until you choose “Accept analytics”. Choosing “Necessary only” keeps it off and leaves the website and quote form available. We use basic consent mode: the Google tag is not downloaded and no Analytics requests are sent before acceptance. Advertising storage, advertising user data and advertising personalisation remain disabled.', 'Open “Cookie settings” at the bottom of any page to change your choice. Withdrawing consent stops future Analytics collection and removes the first-party Analytics cookies we can access. It does not undo processing that took place before withdrawal. A Global Privacy Control signal also prevents Analytics from loading.'] },
  { title: 'Necessary browser storage', body: ['We store your cookie choice in local storage under “bpe-cookie-consent”, together with its version and expiry date, for 180 days. It remembers acceptance or refusal and is not used as a visitor identifier. After expiry, we ask again. If your browser cannot save the choice, Analytics stays off.', 'When you use the logo to return home, a temporary session-storage note lets the next page skip the introductory animation. The next page reads and deletes it. Administrator sign-in uses separate authentication storage; it is not used to track public visitors.'] },
  { title: 'Optional Google Analytics cookies', body: ['When Analytics is configured and you accept, Google Analytics 4 uses first-party cookies named “_ga” and “_ga_” followed by a property identifier to distinguish browsers and maintain session information. We configure these cookies to expire after 180 days, without extending that expiry on each visit.', 'Analytics helps us understand page visits, engagement and broad device information. We disable Google signals and advertising personalisation in our tag, and exclude query strings and fragments from the page address we send. We do not send quote-form contents to Analytics. See our <a href="/privacy/">privacy policy</a> and <a href="https://policies.google.com/privacy">Google’s privacy policy</a>.'] },
  { title: 'Maps and videos: loaded only when requested', body: ['Embedded Google Maps, YouTube and Vimeo content is blocked until you click “Load external content” beside it. That click applies to that content on the current page, separately from Analytics consent. Loading connects to the provider, shares your IP address and browser information, and may allow the provider to read or set cookies. Their cookies and retention are governed by <a href="https://policies.google.com/privacy">Google’s policy</a> or <a href="https://vimeo.com/privacy">Vimeo’s policy</a>. Reloading the page blocks the embed again.', 'Ordinary links to Google Maps, WhatsApp and other websites open those services, where their own privacy and cookie policies apply.'] },
  { title: 'Our separate first-party visit counts', body: ['The website also records limited visit statistics on its own server without browser identifiers or analytics cookies. These are separate from optional Google Analytics. Global Privacy Control switches these counts off. Our <a href="/privacy/">privacy policy</a> explains their purpose, legal basis, retention and your right to object.'] },
];
---
<Legal title="Cookies | BPE Cleaning Services" description="Your cookie choices, optional Google Analytics, necessary storage and external maps and videos." kicker="Cookies" headline={{ line1: 'A clear choice', pre: 'for', accent: 'your', post: 'privacy' }} intro="You decide whether optional analytics runs. Accept or refuse with equal ease, and change your choice whenever you wish." sections={sections} path={PATHS.cookies} crumb="Cookies" />
