---
import { Image } from 'astro:assets';

/**
 * Before/after comparison slider.
 *
 * Only ever use this with two photos of the SAME room at the SAME angle. A pair
 * that does not line up reads as a trick and costs more trust than it buys, so
 * the honest fallback for unmatched shots is the plain Gallery grid instead.
 *
 * The control is a real <input type="range">, so it is keyboard operable and
 * screen-reader announced for free. With JavaScript off it still renders the
 * "after" image at the starting position, which is a fine static result.
 */
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  /** Caption under the slider, e.g. "Hallway, after builders clean". */
  caption?: string;
  /** Starting handle position, 0 to 100. */
  start?: number;
  class?: string;
}

const { before, after, beforeAlt, afterAlt, caption, start = 55, class: klass = '' } = Astro.props;
const id = `ba-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class={`ba not-prose ${klass}`} data-ba style={`--pos:${start}%`}>
  <div class="relative overflow-hidden border border-ink/12 bg-ivory">
    {/* The "before" is the only image in normal flow, so it sets the height of the
        whole component. It must stay h-auto: with h-full it would resolve against
        a parent that has no height of its own and the slider would collapse. */}
    <Image
      src={before}
      alt={beforeAlt}
      widths={[400, 600, 900, 1400]}
      sizes="(min-width: 768px) 640px, 100vw"
      class="block h-auto w-full"
    />

    <div class="ba-after pointer-events-none absolute inset-0">
      <Image
        src={after}
        alt={afterAlt}
        widths={[400, 600, 900, 1400]}
        sizes="(min-width: 768px) 640px, 100vw"
        class="block h-full w-full object-cover"
      />
    </div>

    <span class="ba-tag pointer-events-none absolute left-4 top-4">Before</span>
    <span class="ba-tag ba-tag-after pointer-events-none absolute right-4 top-4">After</span>

    <div class="ba-line pointer-events-none absolute inset-y-0" aria-hidden="true">
      <span class="ba-grip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 6-5 6 5 6" /><path d="m15 6 5 6-5 6" />
        </svg>
      </span>
    </div>

    <label class="sr-only" for={id}>Reveal more of the after photo</label>
    <input
      id={id}
      class="ba-range absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent"
      data-cursor-label="Drag"
      type="range"
      min="0"
      max="100"
      value={start}
      step="0.1"
    />
  </div>

  {caption && <figcaption class="mt-3 font-sans text-xs text-ink/55">{caption}</figcaption>}
</figure>

<style>
  /* The after layer is clipped to the handle position. One custom property drives
     the clip, the divider line and the grip, so a single JS write moves all three. */
  .ba-after {
    clip-path: inset(0 0 0 var(--pos));
  }
  .ba-line {
    left: var(--pos);
    width: 1px;
    background: var(--color-cream);
    box-shadow: 0 0 6px rgb(0 0 0 / 0.25);
  }
  .ba-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    transform: translate(-50%, -50%);
    background: var(--color-cream);
    color: var(--color-night);
  }
  .ba-grip svg {
    width: 1rem;
    height: 1rem;
  }

  .ba-tag {
    padding: 0.4rem 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    background: rgb(20 17 13 / 0.7);
    color: var(--color-cream);
    backdrop-filter: blur(4px);
  }
  .ba-tag-after {
    color: var(--color-gold-soft);
  }

  /* The range sits invisibly over the whole image and does the dragging. */
  .ba-range::-webkit-slider-thumb {
    appearance: none;
    width: 3rem;
    height: 100%;
  }
  .ba-range::-moz-range-thumb {
    width: 3rem;
    height: 100%;
    border: 0;
    background: transparent;
  }
  .ba-range:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ba-after,
    .ba-line {
      transition: none;
    }
  }
</style>

<script>
  // One listener per slider. `input` fires on drag, on click and on arrow keys,
  // so pointer and keyboard are handled by the same path.
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>('.ba-range');
    if (!range) return;
    const paint = () => fig.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', paint);
    paint();
  });
</script>
