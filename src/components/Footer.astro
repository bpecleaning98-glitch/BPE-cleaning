---
import BpeLogo from './brand/BpeLogo.astro';
import { SITE, SERVICES } from '../data/site';
import { AREAS_SENTENCE } from '../data/areas';
const year = new Date().getFullYear();

/**
 * The homepage closes on its own card, "Let's begin", which asks for exactly
 * the same thing this footer line asks for. Two closing calls to action back
 * to back read as a page that has run out of things to say, so the footer
 * keeps its quiet half there and hands the ask to the card above it. Every
 * other page still gets the full line: they end on their own content, not on
 * an invitation.
 */
const isHome = Astro.url.pathname === '/';
---
<footer class="bg-night text-cream">
  <div class="container-wide py-16 md:py-24">
    {!isHome && (
    <div class="flex flex-col gap-4 border-b border-cream/12 pb-12 md:flex-row md:items-end md:justify-between">
      {/* Each caps word sits inside its own overflow-hidden mask, so on
          scroll motion.ts can push the word below its baseline and let it
          rise back up, cut off by the mask edge, each into its own place;
          "you" is never masked and simply condenses in, opacity and blur,
          once the others have landed. Masking the caps words is safe only
          because they are uppercase: no descenders to clip at rest. The
          spans carry no hidden state in markup, the script sets it, so a
          page without the motion chunk simply shows the finished line. */}
      <p class="display-caps text-[clamp(2.4rem,6vw,5rem)] text-cream" data-footer-line>
        <span class="inline-block overflow-hidden align-bottom"><span class="fw-word inline-block">Ready</span></span>
        <span class="inline-block overflow-hidden align-bottom"><span class="fw-word inline-block">when</span></span>
        <span class="fw-you accent-word inline-block text-[0.62em] text-gold-soft">you</span>
        <span class="inline-block overflow-hidden align-bottom"><span class="fw-word inline-block">are</span></span>
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/quote/" class="btn-gold">Get my price</a>
        <a href={SITE.whatsappHref} class="btn-outline text-cream" rel="noopener">WhatsApp</a>
      </div>
    </div>
    )}

    {/* Two columns from the smallest screen up. Stacked, the brand block, eight
        service links and five contact lines made the footer a single strip
        taller than the page above it. Side by side they cost half the height
        and read as a structure rather than a list that will not end. */}
    <div class:list={['grid grid-cols-2 gap-x-6 gap-y-10 md:gap-12 md:grid-cols-[1.4fr_1fr_1fr]', !isHome && 'pt-12']}>
      <div class="col-span-2 md:col-span-1">
        {/* The footer column is portrait on a phone and a wide row from the
            tablet breakpoint up, so it takes the lockup built for each. */}
        <a href="/" class="inline-flex" aria-label={`${SITE.name}, home`}>
          <BpeLogo variant="horizontal" tone="onDark" class="h-11 md:hidden" />
          <BpeLogo variant="horizontal" tone="onDark" class="hidden h-11 md:block" />
        </a>
        <p class="accent-word mt-4 text-lg text-gold-soft md:text-xl">Where clean meets perfection</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/60">{AREAS_SENTENCE}</p>
      </div>

      <nav aria-label="Services">
        <h2 class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.28em] text-gold">Services</h2>
        {/* block + py-1.5 on each anchor: the tap target absorbs the list
            gap (~36px pitch) instead of leaving 20px islands a thumb misses. */}
        <ul class="mt-5 space-y-1">
          {SERVICES.map((s) => (
            <li><a href={s.slug} class="block py-1.5 text-sm text-cream/70 transition-colors hover:text-gold-soft">{s.name}</a></li>
          ))}
          <li><a href="/prices/" class="block py-1.5 text-sm font-semibold text-cream transition-colors hover:text-gold-soft">Full price list</a></li>
          <li><a href="/guides/" class="block py-1.5 text-sm text-cream/70 transition-colors hover:text-gold-soft">Cleaning guides</a></li>
          <li><a href="/blog/" class="block py-1.5 text-sm text-cream/70 transition-colors hover:text-gold-soft">Cleaning advice</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="font-sans text-[0.62rem] font-semibold uppercase tracking-[0.28em] text-gold">Contact</h2>
        <ul class="mt-5 space-y-1 text-sm text-cream/70">
          <li><a href={SITE.phoneHref} class="block py-1.5 font-semibold text-cream transition-colors hover:text-gold-soft">{SITE.phoneDisplay}</a></li>
          <li><a href={SITE.whatsappHref} class="block py-1.5 transition-colors hover:text-gold-soft" rel="noopener">WhatsApp us</a></li>
          <li><span id="footer-email" data-user="bpecleaning98" data-domain="gmail.com"></span></li>
          <li class="py-1.5">{SITE.hours}</li>
        </ul>
      </div>
    </div>
  </div>

  {/* The sign-off: the name at colossal size, and WHOLE. These are the
      identity's own letterforms, lifted straight out of the typographic
      logo, not a serif standing in for them. It sits in the page container,
      on the same gutter as every other row, so the B and the E keep their
      outer edges. A full-bleed version that let the viewport eat the outer
      letters was tried twice and rejected twice: a cropped glyph reads as a
      rendering fault, not as a crop. */}
  <div class="container-wide pb-4" aria-hidden="true">
    {/* The mask the three letters rise out of, and the hook motion.ts looks
        for. It hugs the artwork exactly, because the lockup was trimmed
        tight against the glyphs, so each letter appears from its own
        baseline rather than from some arbitrary line under the row. The
        clip is doubled on purpose: an <svg> root already hides what leaves
        its box, and this says out loud that the overflow is the effect. */}
    <div class="overflow-hidden" data-footer-mark>
      <BpeLogo variant="wordmarkBpe" tone="onDark" sizing="width" class="opacity-95" />
    </div>
  </div>
  <div class="border-t border-cream/12">
    <div class="container-wide flex flex-col items-center justify-between gap-2 py-6 text-xs text-cream/40 md:flex-row">
      <p>
        &copy; {year} BPE Cleaning Services. All rights reserved.
        <a href="/privacy/" class="ml-3 transition-colors hover:text-gold-soft">Privacy</a>
      </p>
      <p>Website by <a href="https://artiomotion.com" class="transition-colors hover:text-gold-soft" rel="noopener">ArtioMotion</a></p>
    </div>
  </div>
</footer>

<script>
  // Email assembled at runtime so scrapers can't harvest it from the source.
  const el = document.getElementById('footer-email');
  if (el instanceof HTMLElement) {
    const addr = `${el.dataset.user}@${el.dataset.domain}`;
    const a = document.createElement('a');
    a.href = `mailto:${addr}`;
    a.textContent = 'Email us';
    a.className = 'block py-1.5 transition-colors hover:text-gold-soft';
    a.setAttribute('aria-label', `Email ${addr}`);
    el.replaceWith(a);
  }
</script>
