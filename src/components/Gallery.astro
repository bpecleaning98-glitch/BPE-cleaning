---
import { Image } from 'astro:assets';

/**
 * Photo grid for real work, with a click-to-enlarge dialog.
 *
 * Every image here is an actual BPE job supplied by the client. Nothing in this
 * component may ever be fed stock photography: the surrounding copy claims these
 * are our own results, so a stock image would make the page a lie.
 *
 * The lightbox is a native <dialog>, which gives focus trapping, Escape to close
 * and the top layer without a library. Without JavaScript the grid still renders
 * and the dialog simply never opens.
 */
export type GalleryItem = {
  src: ImageMetadata;
  alt: string;
  /** Optional short caption shown under the tile. */
  caption?: string;
};

interface Props {
  items: GalleryItem[];
  /** Tiles per row on desktop. */
  cols?: 2 | 3 | 4;
  /** Tile shape. Portrait is useful when the grid sits beside a tall element. */
  aspect?: 'landscape' | 'portrait' | 'square';
  class?: string;
}

const { items, cols = 3, aspect = 'landscape', class: klass = '' } = Astro.props;

const colClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[cols];

const aspectClass = {
  landscape: 'aspect-[4/3]',
  portrait: 'aspect-[3/4]',
  square: 'aspect-square',
}[aspect];
---

{items.length > 0 && (
  <div class={klass} data-gallery>
    <ul class={`grid grid-cols-1 gap-4 ${colClass}`}>
      {items.map((item, i) => (
        <li>
          <button
            type="button"
            class="group relative block w-full overflow-hidden border border-ink/12 bg-ivory focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            data-open={i}
            data-cursor-label="View"
            aria-label={`Enlarge photo: ${item.alt}`}
          >
            <Image
              src={item.src}
              alt={item.alt}
              widths={[400, 700, 1000]}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
              class={`${aspectClass} w-full object-cover transition-transform duration-700 group-hover:scale-[1.045]`}
            />
            <span class="pointer-events-none absolute inset-0 bg-night/0 transition-colors duration-300 group-hover:bg-night/10"></span>
          </button>
          {item.caption && <p class="mt-3 font-sans text-xs text-ink/55">{item.caption}</p>}
        </li>
      ))}
    </ul>

    <dialog
      class="ga-dialog m-auto max-w-[min(94vw,68rem)] border border-cream/15 bg-night p-0 text-cream backdrop:bg-night/85"
      data-lightbox
    >
      <div class="relative">
        {items.map((item, i) => (
          <figure class="ga-slide hidden" data-slide={i}>
            <Image
              src={item.src}
              alt={item.alt}
              widths={[480, 900, 1400, 1900]}
              sizes="min(94vw, 68rem)"
              loading="lazy"
              class="max-h-[80vh] w-full object-contain"
            />
            <figcaption class="border-t border-cream/15 px-5 py-4 font-sans text-xs text-cream/60">{item.caption ?? item.alt}</figcaption>
          </figure>
        ))}

        <button
          type="button"
          class="ga-btn absolute right-3 top-3"
          data-close
          aria-label="Close"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <button type="button" class="ga-btn absolute left-3 top-1/2 -translate-y-1/2" data-prev data-cursor-arrow="left" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6" /></svg>
        </button>
        <button type="button" class="ga-btn absolute right-3 top-1/2 -translate-y-1/2" data-next data-cursor-arrow="right" aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
        </button>
      </div>
    </dialog>
  </div>
)}

<style>
  .ga-slide.is-active {
    display: block;
  }
  .ga-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: rgb(20 17 13 / 0.7);
    color: var(--color-cream);
    border: 1px solid rgb(239 234 224 / 0.25);
    backdrop-filter: blur(4px);
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .ga-btn:hover {
    background: var(--color-cream);
    color: var(--color-night);
  }
  .ga-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .ga-dialog::backdrop {
    backdrop-filter: blur(2px);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (!dialog || !slides.length) return;

    let current = 0;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, n) => s.classList.toggle('is-active', n === current));
    };

    root.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.open));
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Click on the backdrop, i.e. outside the figure, closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
