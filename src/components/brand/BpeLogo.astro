---
import { MARKS, type MarkName } from '../../data/marks';

/**
 * The real identity, from the designer's brand pack. One component, five
 * lockups, because they are the same artwork in different arrangements:
 *
 *   horizontal   the primary lockup. Wide rooms: desktop header, footers,
 *                anywhere a row of space exists.
 *   vertical     the portrait alternative. Phone screens, stacked cards,
 *                square crops. It needs about 90px of height to stay
 *                readable, so it does not belong in a header bar.
 *   wordmark     name only, no symbol. Where the mark is already present or
 *                the space is too small for it to survive.
 *   symbol       the diamond alone. Favicon, watermarks, step markers, any
 *                place the name is already written next to it.
 *   wordmarkBpe  NOT from the designer: generated by trimming the wordmark
 *                down to its BPE letters, with the box pulled tight against
 *                the glyphs. It exists for one job, the full-bleed sign-off
 *                at the foot of the site, where the page edge is meant to
 *                crop the letters. Anywhere else it will look wrong,
 *                because it has no clear space and no CLEANING SERVICES.
 *
 * Colour is driven by two CSS variables, never by the artwork, so the same
 * markup can wear brand colours, the site palette, or plain currentColor.
 */
interface Props {
  variant?: MarkName;
  /**
   * brand  the brand book's own ink and gold, exactly as delivered
   * site   the page palette (warm ink + bronze), for lockups sitting inside
   *        the site's own colour world where the brighter gold would clash
   * onDark the same, inverted for the night bands
   * gold   both halves gold, for watermarks and small marks
   * mono   both halves currentColor, so the parent decides everything.
   *        Required under mix-blend-mode, where a fixed colour turns alien.
   */
  tone?: 'brand' | 'site' | 'onDark' | 'gold' | 'mono';
  class?: string;
  /**
   * How the lockup is measured. 'height' is the normal case: the caller sets
   * a height and the width follows the artwork. 'width' is for the giant
   * cropped sign-off, where the lockup fills its container and the height
   * follows instead.
   */
  sizing?: 'height' | 'width';
  /** Give a title to make it a labelled image; leave empty for decoration. */
  title?: string;
}

const {
  variant = 'horizontal',
  tone = 'site',
  class: className = '',
  sizing = 'height',
  title,
} = Astro.props;
const mark = MARKS[variant];

const TONES: Record<string, string> = {
  brand: '--bpe-ink: #222223; --bpe-gold: #C59A4A',
  site: '--bpe-ink: var(--color-ink); --bpe-gold: var(--color-gold)',
  onDark: '--bpe-ink: var(--color-cream); --bpe-gold: var(--color-gold)',
  gold: '--bpe-ink: var(--color-gold); --bpe-gold: var(--color-gold)',
  mono: '--bpe-ink: currentColor; --bpe-gold: currentColor',
};
---
{/* Sizing is an inline style either way, because display stays a class so a
    caller can still hide one lockup per breakpoint.
      height  the normal case: width:auto pins the SVG to the artwork's own
              proportions, without which an inline SVG defaults to 100% and
              stretches across any flex or grid cell.
      width   the sign-off case: width:100% on purpose, height following. */}
<svg
  class={`bpe-logo block shrink-0 ${className}`}
  viewBox={mark.viewBox}
  style={`${sizing === 'width' ? 'width:100%;height:auto' : 'width:auto'};${TONES[tone]}`}
  data-logo={variant}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
><Fragment set:html={mark.body} /></svg>
