---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The photograph behind a page headline.
 *
 * Every interior page opened on the same bare night band: a kicker, a
 * headline, a paragraph and two buttons, with the right half of the screen
 * empty and, on a phone, nothing above the fold but type. This fills the
 * whole band with a picture and lays the words over it, the way the
 * homepage hero does, on Artiom's call: a first version put the picture
 * BESIDE the text as a grid cell and he turned it down flat, on the phone
 * especially.
 *
 * The section that hosts it must be `relative overflow-hidden`, and its
 * text wrapper `relative`, so the copy paints above this layer.
 *
 * Three ink veils, not one, for the same reason the homepage carries three:
 * a pale interior asks for different weights in different places.
 *
 *   base   on a phone the copy sits at the FOOT of a tall band (the section
 *          is flex, justify-end, min-h 76svh), so the veil is light at the
 *          top where the room shows and gathers to near-opaque from 28%
 *          down, which is where the gold kicker begins. The band was 88svh
 *          first; Artiom found the top empty and the copy crammed at the
 *          foot, so it shortened and the copy rose with it. From md the copy is
 *          at the foot of a shorter band and the vertical veil relaxes.
 *   left   md and up only: the headline's own shadow. The copy never
 *          leaves the left half on a desktop, and every frame in
 *          src/assets/ai/ was briefed with its subject in the right half,
 *          so the two halves of the picture do different jobs.
 *   top    the header renders under mix-blend-difference and needs a
 *          decidedly dark backdrop: over a mid grey it comes out mid grey.
 *
 * No data-drift on purpose: that hook pulls GSAP and ScrollTrigger onto
 * pages that currently download neither.
 */
/**
 * A ready-made responsive set under public/, for pages astro:assets cannot
 * serve. A server-rendered page (prerender = false) gets no image files at
 * build time; <Image> there points at the runtime endpoint /_image, which
 * answers 404 on Vercel. scripts/build-hero-static.mjs writes the set.
 */
export interface StaticHero {
  src: string;
  srcset: string;
  width: number;
  height: number;
}

interface Props {
  src: ImageMetadata | StaticHero;
  alt: string;
  /**
   * object-position. On a phone the frame is a narrow vertical slice of a
   * wide room and dead centre lands on bare wall, so each page names the
   * horizontal point that keeps its subject inside the slice.
   */
  position?: string;
}

const { src, alt, position = '70% 50%' } = Astro.props;
const isStatic = 'srcset' in src;
---
{/* The largest element on the first screen, so the LCP candidate on every
    page that uses it: eager, high priority, and a plain fade rather than a
    rise, so it is painted the moment it arrives. */}
<div class="absolute inset-0" data-reveal="fade">
  {isStatic ? (
    <img
      src={src.src}
      srcset={src.srcset}
      sizes="100vw"
      width={src.width}
      height={src.height}
      alt={alt}
      class="h-full w-full object-cover"
      style={`object-position: ${position}`}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      class="h-full w-full object-cover"
      style={`object-position: ${position}`}
      widths={[480, 768, 1280, 1600]}
      sizes="100vw"
      format="webp"
      quality={76}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  )}
  <div
    class="absolute inset-0 bg-gradient-to-b from-night/25 via-night/86 via-28% to-night/96 md:from-night/45 md:via-night/55 md:via-50% md:to-night/88"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 hidden bg-gradient-to-r from-night/85 via-night/40 to-night/5 md:block"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-night/80 to-transparent"
    aria-hidden="true"
  ></div>
</div>
