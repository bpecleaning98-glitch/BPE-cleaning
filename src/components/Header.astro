---
import BpeLogo from './brand/BpeLogo.astro';
import { SITE } from '../data/site';

// Elicyon header anatomy: nav on the LEFT, logo dead centre, a single
// underlined CONTACT US on the RIGHT. Fixed and transparent over the dark
// band every page opens with, porcelain once scrolled.
const nav = [
  // A real page, not an anchor jump on the homepage: clearer UX.
  { href: '/services/', label: 'Services' },
  { href: '/prices/', label: 'Prices' },
  { href: '/airbnb-cleaning-dublin/', label: 'Airbnb' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
---
{/* Always transparent, never a bar. Contrast is solved the same way as the
    cursor: the whole header renders under mix-blend-mode difference, so
    over dark sections it shows warm gold-soft and over light ones it
    re-colours itself dark automatically, wherever it happens to overlap.
    Scrolling DOWN slides it away gently; scrolling UP brings it back. */}
{/* data-scrolled used to add a soft backdrop blur here, to stop the bar
    garbling into section text when it came back mid-page. It is gone, and
    it is not coming back on this element: backdrop-filter and
    mix-blend-mode on the SAME element is broken in WebKit. The blur paints
    the blurred backdrop inside the header box, difference then subtracts
    the unblurred backdrop from it, and over any flat stretch the two are
    equal, so the result is zero: a solid black slab. On an iPhone, and
    inside the Instagram browser, that slab snapped in the instant you
    scrolled past 28px. Chrome isolates the two layers and looked fine,
    which is the only reason it survived this long; Safari on a Mac showed
    it too.

    The blend alone was always doing the real work, so nothing was lost.
    data-scrolled stays on the element, because the light-page rule in
    global.css reads it to decide when to hand the blend back. */}
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[70] mix-blend-difference text-gold-soft transition-transform duration-700 [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] data-[hidden]:-translate-y-full"
>
  <div class="container-wide grid h-[84px] grid-cols-[1fr_auto_1fr] items-center md:h-[88px]">
    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} class="link-caps opacity-80 transition-opacity hover:opacity-100">{item.label}</a>
      ))}
    </nav>
    {/* One button, not two. MENU and CLOSE live on adjacent faces of a 3D
        box, so opening the menu rolls the box a quarter turn: MENU tips up
        and away, CLOSE arrives from below. The roll IS the state change, and
        closing rolls it back, which is why there is no separate close button
        and no second header inside the overlay.

        The header itself never moves. It sits above the curtain at z-70, so
        the lockup stays exactly where it was and mix-blend-difference
        recolours it against the night as the curtain passes under it. The
        previous version duplicated the logo inside the overlay, left aligned,
        so the real one appeared to vanish and a second one slid in from the
        side. That was the chaos Artiom described. */}
    <button
      id="menu-toggle"
      class="link-caps cube justify-self-start after:hidden lg:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="menu-overlay"
    >
      <span class="cube-box">
        <span class="cube-face">Menu</span>
        <span class="cube-face">Close</span>
      </span>
    </button>

    {/* The primary horizontal lockup, at every width. The vertical one was
        tried here first and rejected on evidence: a header bar gives it about
        44px of height, and at that size its CLEANING SERVICES line collapses
        into a smudge. It needs roughly 90px to read, which it gets in the
        footer and the closing card instead. 36px is the smallest height at
        which the horizontal lockup still holds its second line together.
        Mono, because the whole header renders under mix-blend-difference and
        the brand gold would come out blue-violet over light sections. */}
    <a href="/" class="logo-slot flex items-center justify-self-center" aria-label={`${SITE.name}, home`}>
      <BpeLogo variant="horizontal" tone="mono" class="h-9 md:h-10" />
    </a>

    <div class="flex items-center gap-8 justify-self-end">
      <a href={SITE.phoneHref} class="link-caps hidden opacity-80 hover:opacity-100 xl:inline-flex" aria-label={`Call ${SITE.phoneDisplay}`}>
        {SITE.phoneDisplay}
      </a>
      <a href="/contact/" class="link-caps after:scale-x-100 after:origin-left hover:after:scale-x-0 hover:after:origin-right">
        Contact us
      </a>
    </div>
  </div>
</header>

{/* Full-screen overlay menu, the reference's mobile anatomy: a solid night
    curtain that slides DOWN from the top edge (transform only, so it cannot
    stutter), links dead centre in oversized serif, small tracked-caps
    columns pinned to the foot. Each .m-stag child fades and lifts in on its
    own delay once the curtain is down; closing drops the delays, so the
    items vanish together while the curtain rises. */}
<div
  id="menu-overlay"
  class="pointer-events-none fixed inset-0 z-[60] -translate-y-full overflow-y-auto overscroll-contain bg-night pb-10 text-cream transition-transform duration-700 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] data-[open]:pointer-events-auto data-[open]:translate-y-0"
  aria-hidden="true"
  inert
  data-lenis-prevent
>
  {/* pt clears the real header, which is floating over this curtain rather
      than being replaced by one of its own. */}
  <div class="flex min-h-full flex-col pt-[84px] md:pt-[88px]">
    <nav class="container-wide my-auto flex flex-col items-center gap-3 py-10 text-center" aria-label="Menu">
      {[...nav, { href: '/contact/', label: 'Contact' }].map((item, i) => (
        <a
          href={item.href}
          class="m-stag display-caps text-[2.2rem] leading-[1.15] text-cream/90 transition-colors hover:text-gold sm:text-[2.7rem]"
          style={`--i: ${i}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="container-wide grid shrink-0 grid-cols-2 gap-x-6 gap-y-4">
      <div class="flex flex-col items-start gap-4">
        <a href={SITE.phoneHref} class="m-stag link-caps text-gold" style="--i: 6">{SITE.phoneDisplay}</a>
        <a href={SITE.whatsappHref} class="m-stag link-caps opacity-70" style="--i: 7" rel="noopener">WhatsApp</a>
      </div>
      <div class="flex flex-col items-end gap-4">
        <a href="/quote/" class="m-stag link-caps text-gold" style="--i: 8">Get my price</a>
        <a href="/prices/" class="m-stag link-caps opacity-70" style="--i: 9">Full price list</a>
      </div>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  let lastY = window.scrollY;
  const onScroll = () => {
    if (!header) return;
    const y = window.scrollY;
    if (y < 28) {
      // At the very top: always present, no backdrop.
      header.removeAttribute('data-hidden');
      header.removeAttribute('data-scrolled');
    } else {
      header.setAttribute('data-scrolled', '');
      // Direction decides visibility; the 6px deadband ignores jitter.
      if (y > lastY + 6) header.setAttribute('data-hidden', '');
      else if (y < lastY - 6) header.removeAttribute('data-hidden');
    }
    lastY = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const overlay = document.getElementById('menu-overlay');
  const toggle = document.getElementById('menu-toggle');
  /* Holding the page still while the menu is open must NOT be done with
   * overflow:hidden. That deletes the scrollbar, the viewport grows by its
   * width, and any ScrollTrigger measurement that lands in that window bakes
   * the wider number into the pinned Manifesto section, leaving the whole
   * site 15px too wide with a horizontal scrollbar under it once the menu
   * closes. Lenis owns the wheel and touch, so stopping it is enough, and
   * the layout never moves. */
  const lenis = () => (window as unknown as { __lenis?: { stop: () => void; start: () => void } }).__lenis;

  // The cube stays turned for as long as the menu is open, so the button
  // reads CLOSE the whole time rather than flashing it and rolling back.
  const setOpen = (open: boolean) => {
    if (!overlay || !toggle) return;
    overlay.toggleAttribute('data-open', open);
    overlay.setAttribute('aria-hidden', String(!open));
    // aria-hidden alone was a lie the keyboard could disprove: the curtain
    // was only pointer-events-none, so its ten links stayed in the tab order
    // while the page swore they were not there. inert removes them from both
    // the accessibility tree and the focus order, and hands them back
    // together when the curtain comes down.
    overlay.toggleAttribute('inert', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('cube-turned', open);
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) lenis()?.stop();
    else lenis()?.start();
  };
  toggle?.addEventListener('click', () => setOpen(!overlay?.hasAttribute('data-open')));
  overlay?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
