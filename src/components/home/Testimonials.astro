---
import { TESTIMONIALS } from '../../data/testimonials';

/**
 * Homepage keeps ONE voice only: the City Stays reference (80+ properties),
 * as the scroll-brightening pull quote. The other references live on the
 * About page, per the rule that the homepage never repeats an inner page.
 * Section renders nothing if the store is ever emptied.
 */
const lead = TESTIMONIALS[0];
const leadWords = lead ? lead.quote.split(' ') : [];
---

{lead && (
  <section class="section-pad bg-porcelain">
    <div class="container-wide">
      {/* Centred: a section carrying one voice reads better as a centrepiece
          than as yet another left-anchored block. */}
      <div class="text-center">
        <p class="kicker" data-reveal>What Clients Say</p>
        <h2 class="display mt-6 text-[clamp(2.2rem,5vw,4rem)] text-ink" data-reveal>
          <span class="line-mask"><span><span class="accent-word text-gold-deep">trusted</span> across Dublin</span></span>
        </h2>
      </div>

      <figure class="mx-auto mt-16 grid max-w-4xl gap-6 md:grid-cols-[auto_1fr] md:gap-10">
        <span class="display block select-none text-[6rem] leading-[0.6] text-gold md:text-[9rem]" aria-hidden="true">&ldquo;</span>
        <div class="max-w-3xl">
          <blockquote data-quote-scrub>
            <p class="display text-[clamp(1.5rem,2.9vw,2.4rem)] leading-[1.3] text-ink">
              {leadWords.map((word) => (
                <span class="q-word">{word}{' '}</span>
              ))}
            </p>
          </blockquote>
          <figcaption class="mt-8 flex flex-wrap items-center justify-between gap-4">
            <span class="flex items-center gap-4">
              <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
              <span class="font-sans text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-ink/70">
                {lead.author} &middot; {lead.area}
              </span>
            </span>
            <a href="/about/" class="link-caps text-gold-deep">More client words</a>
          </figcaption>
        </div>
      </figure>
    </div>
  </section>
)}
